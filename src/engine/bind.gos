use crate::codec
use crate::sql

// A statement's `?` placeholders filled from the values a caller bound.
//
// A bound value is a value: it is narrowed to its column's type the way a
// literal is, and the text a caller holds never reaches the parser, so a name
// carrying a quote or a semicolon is a name and not a statement.

/// Fills `s`'s `?` placeholders from `args`, in the order they were written.
///
/// A statement carrying no placeholder is answered as it stands, and one whose
/// placeholder count differs from `args` is refused before it reads or writes.
pub (package) fn stmt(s: sql::Stmt, args: Vec<codec::Value>) -> Result<sql::Stmt, String> {
    let n = arity(s)
    if n != args.len() {
        return Err("statement takes " + n.to_string() + " argument(s), got " +
            args.len().to_string())
    }
    if n == 0 { return Ok(s) }
    // Placeholders are numbered from zero in the order the parser met them, so
    // the highest of them plus one is the count: every index is in range here.
    match s {
        sql::Stmt::Insert { table, cols, rows } => {
            let mut bound: Vec<Vec<codec::Value>> = #[]
            for row in rows {
                let mut vals: Vec<codec::Value> = #[]
                for v in row { vals.push(filled(v, args)) }
                bound.push(vals)
            }
            Ok(sql::Stmt::Insert { table: table, cols: cols, rows: bound })
        }
        sql::Stmt::Update { table, sets, conds } => {
            let mut bound: Vec<(String, codec::Value)> = #[]
            for (col, v) in sets { bound.push((col, filled(v, args))) }
            Ok(sql::Stmt::Update { table: table, sets: bound, conds: filled_conds(conds, args) })
        }
        sql::Stmt::Delete { table, conds } => {
            Ok(sql::Stmt::Delete { table: table, conds: filled_conds(conds, args) })
        }
        sql::Stmt::Select(q) => {
            let mut bound = q
            bound.conds = filled_conds(q.conds, args)
            Ok(sql::Stmt::Select(bound))
        }
        other => Ok(other)
    }
}

// The number of `?` placeholders a statement carries: the highest placeholder
// number it names, plus one.
fn arity(s: sql::Stmt) -> i64 {
    match s {
        sql::Stmt::Insert { rows, .. } => {
            let mut n: i64 = 0
            for row in rows {
                for v in row { n = highest(n, v) }
            }
            n
        }
        sql::Stmt::Update { sets, conds, .. } => {
            let mut n: i64 = 0
            for (_, v) in sets { n = highest(n, v) }
            for c in conds { n = highest(n, c.val) }
            n
        }
        sql::Stmt::Delete { conds, .. } => {
            let mut n: i64 = 0
            for c in conds { n = highest(n, c.val) }
            n
        }
        sql::Stmt::Select(q) => {
            let mut n: i64 = 0
            for c in q.conds { n = highest(n, c.val) }
            n
        }
        _ => 0
    }
}

fn highest(n: i64, v: codec::Value) -> i64 {
    if v.tag == codec::TAG_PARAM && v.i + 1 > n { v.i + 1 } else { n }
}

fn filled(v: codec::Value, args: Vec<codec::Value>) -> codec::Value {
    if v.tag == codec::TAG_PARAM { args[v.i] } else { v }
}

fn filled_conds(conds: Vec<sql::Cond>, args: Vec<codec::Value>) -> Vec<sql::Cond> {
    let mut bound: Vec<sql::Cond> = #[]
    for c in conds {
        bound.push(sql::Cond { col: c.col, op: c.op, val: filled(c.val, args) })
    }
    bound
}


#[cfg(test)]
mod tests {
    use std::fs
    use crate::codec
    use crate::engine

    fn fresh(name: String) -> String {
        let dir = "/tmp/terndb_engine_test/" + name
        let _ = fs::remove_dir_all(dir)
        let _ = fs::create_dir_all(dir)
        dir
    }

    fn opened(dir: String) -> engine::Engine {
        engine::open(dir, false).unwrap_or_else(|e| panic("open " + dir + ": " + e))
    }

    fn run(eng: &mut engine::Engine, src: String, args: Vec<codec::Value>) -> i64 {
        match eng.exec_args(src, args) {
            Ok(res) => return res.count
            Err(e) => {
                assert(false, src + " -> " + e)
                return -1
            }
        }
    }

    fn rows(eng: &mut engine::Engine, src: String, args: Vec<codec::Value>) -> Vec<Vec<String>> {
        match eng.exec_args(src, args) {
            Ok(res) => {
                let mut out: Vec<Vec<String>> = #[]
                for row in res.rows {
                    let mut cells: Vec<String> = #[]
                    for v in row.vals { cells.push(v.to_string()) }
                    out.push(cells)
                }
                return out
            }
            Err(e) => {
                assert(false, src + " -> " + e)
                return #[]
            }
        }
    }

    fn users(eng: &mut engine::Engine) {
        assert_eq(run(eng, "CREATE TABLE users (name TEXT, age INT32, active BOOL, at DATETIME, score FLOAT)", #[]), 0)
    }

    #[test]
    fn a_bound_value_is_a_value_and_never_statement_text() {
        let mut eng = opened(fresh("bind_values"))
        users(&mut eng)
        // A name carrying the punctuation of a statement is stored and read
        // back as the name it is.
        let hostile = "ada'); DELETE FROM users; --"
        assert_eq(run(&mut eng, "INSERT INTO users VALUES (?, ?, ?, ?, ?)"
            #[codec::Value::text(hostile), codec::Value::int(30), codec::Value::bool(true)
                codec::Value::text("2023-11-14T22:13:20Z"), codec::Value::float(1.5)]), 1)
        assert_eq(rows(&mut eng, "SELECT name FROM users WHERE name = ?", #[codec::Value::text(hostile)])
            #[#[hostile]])
        assert_eq(rows(&mut eng, "SELECT COUNT(*) FROM users", #[]), #[#["1"]])
    }

    #[test]
    fn every_statement_that_carries_a_value_takes_arguments() {
        let mut eng = opened(fresh("bind_statements"))
        users(&mut eng)
        assert_eq(run(&mut eng, "INSERT INTO users VALUES (?, ?, ?, ?, ?), (?, ?, ?, ?, ?)"
            #[codec::Value::text("alice"), codec::Value::int(30), codec::Value::bool(true)
                codec::Value::text("2023-11-14T22:13:20Z"), codec::Value::float(1.5)
                codec::Value::text("bob"), codec::Value::int(40), codec::Value::bool(false)
                codec::Value::text("2023-12-01T10:00:00Z"), codec::Value::float(2.5)]), 2)
        assert_eq(rows(&mut eng, "SELECT name FROM users WHERE age > ? AND active = ?"
            #[codec::Value::int(20), codec::Value::bool(true)]), #[#["alice"]])
        assert_eq(rows(&mut eng, "SELECT name FROM users WHERE rowid = ?", #[codec::Value::int(2)])
            #[#["bob"]])
        assert_eq(run(&mut eng, "UPDATE users SET score = ? WHERE name = ?"
            #[codec::Value::float(9.5), codec::Value::text("bob")]), 1)
        assert_eq(rows(&mut eng, "SELECT score FROM users WHERE name = ?", #[codec::Value::text("bob")])
            #[#["9.5"]])
        assert_eq(run(&mut eng, "DELETE FROM users WHERE score = ?", #[codec::Value::float(9.5)]), 1)
        assert_eq(rows(&mut eng, "SELECT COUNT(*) FROM users", #[]), #[#["1"]])
    }

    #[test]
    fn a_bound_value_is_narrowed_the_way_a_literal_is() {
        let mut eng = opened(fresh("bind_narrow"))
        users(&mut eng)
        // A datetime column takes the text spelling, bound or written.
        assert_eq(run(&mut eng, "INSERT INTO users VALUES (?, ?, ?, ?, ?)"
            #[codec::Value::text("alice"), codec::Value::int(30), codec::Value::bool(true)
                codec::Value::text("2023-11-14T22:13:20Z"), codec::Value::float(1.5)]), 1)
        assert_eq(rows(&mut eng, "SELECT name FROM users WHERE at = ?"
            #[codec::Value::text("2023-11-14T22:13:20Z")]), #[#["alice"]])
        // An INT32 column takes a whole number in its range and nothing else.
        assert(eng.exec_args("UPDATE users SET age = ?", #[codec::Value::int(1 << 40)]).is_err()
            "out of the column's range")
        assert(eng.exec_args("UPDATE users SET age = ?", #[codec::Value::text("thirty")]).is_err()
            "text does not fit a whole number")
    }

    #[test]
    fn a_statement_is_refused_unless_its_placeholders_are_all_bound() {
        let mut eng = opened(fresh("bind_arity"))
        users(&mut eng)
        assert(eng.exec("SELECT * FROM users WHERE name = ?").is_err()
            "no argument for the placeholder")
        assert(eng.exec_args("SELECT * FROM users WHERE name = ? AND age = ?"
            #[codec::Value::text("alice")]).is_err(), "one argument short")
        assert(eng.exec_args("SELECT * FROM users", #[codec::Value::int(1)]).is_err()
            "one argument too many")
        assert(eng.exec_args("INSERT INTO users VALUES (?, ?, ?, ?, ?)", #[]).is_err()
            "an unbound INSERT writes nothing")
        assert_eq(rows(&mut eng, "SELECT COUNT(*) FROM users", #[]), #[#["0"]])
    }
}
