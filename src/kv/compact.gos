use std::fs
use std::encoding::binary
use std::hash::crc32
use crate::kv
use super::log
use super::recover
use super::rows

// Merging the log: the live records of the generations worth rewriting go into
// one sealed generation, and the space the superseded ones held is reclaimed.
//
// A merge is what makes an append-only log bounded by its live data rather than
// by everything ever written to it.

const HINT_FLUSH: i64 = 65_536

// A store merges itself when this much of its log is superseded, and only once
// it is large enough for the merge to be worth its own writes. Half is the
// point where a merge rewrites less than it reclaims, and because a merge
// leaves nothing dead behind it the log has to roughly double before the next
// one, so merges space themselves out however hard the store is written.
pub (package) const AUTO_COMPACT_RATIO: f64 = 0.5

const AUTO_COMPACT_MIN_BYTES: i64 = 1_048_576

/// Whether the log holds enough superseded bytes to be worth merging.
///
/// Both halves matter: the ratio says a merge reclaims more than it rewrites,
/// and the floor keeps a small store from merging on its first overwrite, when
/// the ratio is easy to reach and there is nothing to reclaim.
pub fn due(st: &mut kv::Store) -> bool {
    if st.read_only || st.auto_compact <= 0.0 { return false }
    if st.live_bytes + st.dead_bytes < AUTO_COMPACT_MIN_BYTES { return false }
    dead_ratio(st) >= st.auto_compact
}

/// Sets the fraction of superseded log a commit will tolerate before merging,
/// or 0 to leave merging to the caller.
pub fn set_ratio(st: &mut kv::Store, ratio: f64) { st.auto_compact = ratio }

/// Fraction of the log occupied by superseded records, as a value in [0, 1].
pub fn dead_ratio(st: &mut kv::Store) -> f64 {
    let total = st.live_bytes + st.dead_bytes
    if total <= 0 { return 0.0 }
    (st.dead_bytes as f64) / (total as f64)
}

// Hint records are written out in blocks rather than accumulated whole: the
// hint file for a large store is otherwise held in memory in its entirety.
fn flush_hints(f: fs::File, buf: Vec<u8>, off: i64) -> Result<i64, String> {
    if buf.len() == 0 { return Ok(off) }
    match f.write_at(buf, off) {
        Ok(n) => {
            if n != buf.len() { return Err("compact: short hint write") }
            Ok(off + n)
        }
        Err(e) => Err("compact: hint write: " + e.message())
    }
}

// What each generation's live records occupy, keyed by generation. The index is
// the only thing that knows which records are still live, so this is where a
// generation's waste is worked out from.
pub (package) fn live_by_gen(st: &mut kv::Store) -> Map<i64, i64> {
    let mut live_in: Map<i64, i64> = Map::new()
    for k in st.index.keys() {
        if let Some(e) = st.index.get(k) {
            let n = log::record_len(k, e.vlen)
            let _ = live_in.insert(e.file, live_in.get(e.file).unwrap_or(0) + n)
        }
    }
    let mut t: i64 = 0
    while t < st.tables.len() {
        let top = st.tables[t].top
        let mut rid: i64 = 1
        while rid <= top {
            let gc = st.tables[t].slots[3 * rid + 1]
            if gc != 0 {
                let n = rows::row_record_len(st, t, rid, log::loc_vlen(st.tables[t].slots[3 * rid]))
                let g = log::gc_gen(gc)
                let _ = live_in.insert(g, live_in.get(g).unwrap_or(0) + n)
            }
            rid += 1
        }
        t += 1
    }
    live_in
}

// Recomputes what the log holds, from the records the index points at and the
// sizes of the files they sit in. A merge that left generations alone cannot
// work its accounting out from what it moved, so it asks the files.
//
// `framing` is the bytes among them that structure the log rather than waste
// space in it - the commit record a merge seals its generation with - so that a
// freshly merged store reports nothing dead rather than its own framing.
fn reaccount(st: &mut kv::Store, framing: i64) -> Result<(), String> {
    let live_in = live_by_gen(st)
    let mut live: i64 = 0
    for k in st.index.keys() {
        if let Some(e) = st.index.get(k) { live += e.vlen }
    }
    let mut t: i64 = 0
    while t < st.tables.len() {
        let top = st.tables[t].top
        let mut rid: i64 = 1
        while rid <= top {
            if st.tables[t].slots[3 * rid + 1] != 0 {
                live += log::loc_vlen(st.tables[t].slots[3 * rid])
            }
            rid += 1
        }
        t += 1
    }
    let mut dead: i64 = 0
    for e in log::dir_entries(st.dir)? {
        if let Some(g) = log::parse_gen(e.name, ".data") {
            let held = live_in.get(g).unwrap_or(0)
            if e.size > held { dead += e.size - held }
        }
    }
    st.live_bytes = live
    st.dead_bytes = if dead > framing { dead - framing } else { 0 }
    Ok(())
}

// The generations worth merging: the active one, whose dead bytes cannot be
// reclaimed until it is sealed, and every sealed one that is mostly dead. A
// generation still nearly all live is left where it is, so a large cold table
// is not rewritten every time a small hot one is merged.
fn dirty_generations(st: &mut kv::Store) -> Result<Vec<i64>, String> {
    let live_in = live_by_gen(st)
    let mut out: Vec<i64> = #[]
    for e in log::dir_entries(st.dir)? {
        if let Some(g) = log::parse_gen(e.name, ".data") {
            if g == st.gen {
                out.push(g)
            } else if e.size > 0 {
                let held = live_in.get(g).unwrap_or(0)
                let dead = if e.size > held { e.size - held } else { 0 }
                if (dead as f64) / (e.size as f64) >= st.auto_compact { out.push(g) }
            }
        }
    }
    out.sort()
    Ok(out)
}

/// Rewrites the live records of every generation into one sealed generation and
/// starts a fresh active file.
pub fn run(st: &mut kv::Store) -> Result<(), String> {
    let all = log::data_generations(st.dir)?
    compact_into(st, all)
}

// Merges only the generations that are mostly dead, which is what a store
// merging itself does: a record that is not wasting space is left where it is
// rather than rewritten for the sake of records that are.
pub (package) fn compact_dirty(st: &mut kv::Store) -> Result<(), String> {
    let dirty = dirty_generations(st)?
    compact_into(st, dirty)
}

// Where the merge put each record it moved, and where the merged generation
// ends. The index is only pointed at them once the walk is over: the index the
// walk reads to find the live records is the one it would otherwise rewrite.
//
// Rows are kept as the table, row id and the two slot words that place them,
// so moving one builds no key; the few keys the hash index holds keep theirs.
struct Moved {
    tids: Vec<i64>
    rids: Vec<i64>
    locs: Vec<i64>
    gcs: Vec<i64>
    keys: Vec<String>
    entries: Vec<kv::Entry>
    end: i64
}

// What the merge is writing: the merged generation's bytes not yet written and
// where they go, and the hint being built beside them.
struct Out {
    mf: fs::File
    buf: Vec<u8>
    at: i64
    hf: fs::File
    hbuf: Vec<u8>
    hoff: i64
    /// Checksum of every hint byte written so far, which the hint's trailer
    /// carries so a hint that was damaged is never trusted.
    hcrc: i64
    hcount: i64
}

fn compact_into(st: &mut kv::Store, merging: Vec<i64>) -> Result<(), String> {
    if st.read_only { return Err("store is read-only") }
    if merging.len() == 0 { return Ok(()) }
    let merged = newest_generation(st)? + 1
    let mf = log::open_append(log::data_path(st.dir, merged))?
    // The hint file is built through a staging path so the merged generation is
    // only ever sealed by a hint that is complete and describes durable data.
    let hstage = log::hint_path(st.dir, merged) + ".part"
    let hf = log::open_fresh(hstage)?
    let mut out = Out { mf: mf, buf: #[], at: 0, hf: hf, hbuf: #[], hoff: 0, hcrc: 0, hcount: 0 }
    out.hbuf.extend(recover::HINT_MAGIC.as_bytes())
    let moved = move_live(st, merging, &mut out, merged)?
    seal(&mut out, hstage, log::hint_path(st.dir, merged), st.dir)?
    start_active(st, merged + 1)?
    for i in 0..moved.rids.len() {
        let s = 3 * moved.rids[i]
        st.tables[moved.tids[i]].slots[s] = moved.locs[i]
        st.tables[moved.tids[i]].slots[s + 1] = moved.gcs[i]
    }
    for i in 0..moved.keys.len() { let _ = st.index.insert(moved.keys[i], moved.entries[i]) }
    drop_merged(st, merging, merged)?
    // The merge wrote one commit record to seal the generation it made.
    reaccount(st, log::HEADER_LEN)?
    // The generations the store held may be gone and the merged one is new.
    rows::admit_resident(st)
    Ok(())
}

// The highest generation the store holds, which the merge writes past.
fn newest_generation(st: &mut kv::Store) -> Result<i64, String> {
    let mut newest = st.gen
    for g in log::data_generations(st.dir)? {
        if g > newest { newest = g }
    }
    Ok(newest)
}

// Copies the live records of `merging` into the merged generation, writing the
// hint that will seal it as it goes. A record in a generation nobody is merging
// stays where it is, and so does the index entry pointing at it.
//
// Each record is copied as it lies - header, key and value - after checking it
// against the checksum the index carries: the key and value are unchanged, so
// the checksum the record was written with is still the right one.
//
// A record the merge cannot read is one it would drop on the floor: the
// generations it came from are removed once the merge is done, so a record that
// fails its checksum stops the merge instead.
fn move_live(st: &mut kv::Store, merging: Vec<i64>, out: &mut Out, merged: i64) -> Result<Moved, String> {
    let mut moved = Moved { tids: #[], rids: #[], locs: #[], gcs: #[], keys: #[], entries: #[], end: 0 }
    let mut hashed: Vec<String> = #[]
    for k in st.index.keys() {
        if let Some(e) = st.index.get(k) {
            if merging.contains(e.file) { hashed.push(k) }
        }
    }
    hashed.sort()
    out.hbuf.push(recover::HINT_KEYS)
    log::push_le(&mut out.hbuf, hashed.len(), 8)
    for k in hashed {
        let e = match st.index.get(k) {
            Some(e) => e
            None => continue
        }
        let rec = whole_record(st, k, e)?
        let at = emit(out, rec, 0, rec.len())?
        moved.keys.push(k)
        moved.entries.push(kv::Entry { file: merged, offset: at, vlen: e.vlen, crc: e.crc })
        hint_into(&mut out.hbuf, k, e.vlen, e.crc, at)
        out.hcount += 1
        flush_hints_due(out)?
    }
    for tid in 0..st.tables.len() {
        move_table(st, tid, merging, out, merged, &mut moved)?
    }
    moved.end = out.at + out.buf.len()
    Ok(moved)
}

// Moves one table's rows in row-id order, so the merged generation holds each
// table's rows where a walk up the row ids reads them one block after another.
fn move_table(st: &mut kv::Store, tid: i64, merging: Vec<i64>, out: &mut Out, merged: i64, moved: &mut Moved) -> Result<(), String> {
    // The section header names how many rows follow and the highest of them, so
    // a reader sizes the table once rather than a row at a time.
    let mut count: i64 = 0
    let mut top: i64 = 0
    for rid in 1..st.tables[tid].top + 1 {
        let gc = st.tables[tid].slots[3 * rid + 1]
        if gc != 0 && merging.contains(log::gc_gen(gc)) {
            count += 1
            top = rid
        }
    }
    if count == 0 { return Ok(()) }
    out.hbuf.push(recover::HINT_TABLE)
    log::push_le(&mut out.hbuf, st.tables[tid].name.byte_len(), 2)
    out.hbuf.extend(st.tables[tid].name.as_bytes())
    log::push_le(&mut out.hbuf, count, 8)
    log::push_le(&mut out.hbuf, top, 8)
    let mut cur = rows::cursor(tid, 1)
    for rid in 1..top + 1 {
        let s = 3 * rid
        let gc = st.tables[tid].slots[s + 1]
        if gc == 0 || !merging.contains(log::gc_gen(gc)) { continue }
        let head = rows::row_record_len(st, tid, rid, 0)
        let at = match rows::locate(st, &mut cur, rid) {
            rows::Place::Absent => return Err("compact: row " + rid.to_string() + " of " + st.tables[tid].name + " went missing during the merge")
            rows::Place::Fault(e) => return Err("compact: " + e)
            rows::Place::Resident(a, b) => copy_row(out, st.resident_bytes, a - head, b, gc)?
            rows::Place::Block(w, a, b) => copy_row(out, cur.blocks[w], a - head, b, gc)?
        }
        let loc = st.tables[tid].slots[s]
        moved.tids.push(tid)
        moved.rids.push(rid)
        moved.locs.push(log::pack_loc(at, log::loc_vlen(loc)))
        moved.gcs.push(log::pack_gc(merged, log::gc_crc(gc)))
        log::push_le(&mut out.hbuf, rid, 8)
        log::push_le(&mut out.hbuf, at, 8)
        log::push_le(&mut out.hbuf, log::loc_vlen(loc), 4)
        log::push_le(&mut out.hbuf, log::gc_crc(gc), 4)
        log::push_le(&mut out.hbuf, st.tables[tid].slots[s + 2], 4)
        out.hcount += 1
        flush_hints_due(out)?
    }
    Ok(())
}

// Checks the record in `src[start..end]` against the checksum its slot
// carries and copies it into the merge, answering where it now starts.
//
// The value was already checked when it was placed; this checks the header and
// key it carries as well, so a record copied as it lies is as sound as one
// written afresh.
fn copy_row(out: &mut Out, src: Vec<u8>, start: i64, end: i64, gc: i64) -> Result<i64, String> {
    if !record_holds(src, start, end, log::gc_crc(gc)) { return Err("compact: a record's header does not match its row") }
    emit(out, src, start, end)
}

// Whether `buf[start..end]` is one whole put record whose header and contents
// agree with each other and with the checksum `crc` the index carries.
fn record_holds(buf: Vec<u8>, start: i64, end: i64, crc: i64) -> bool {
    if start < 0 || end > buf.len() || end - start < log::HEADER_LEN { return false }
    let stored = binary::get_u32_le_at(buf, start).unwrap_or(0u32) as i64
    let klen = binary::get_u16_le_at(buf, start + 5).unwrap_or(0u16) as i64
    let vlen = binary::get_u32_le_at(buf, start + 7).unwrap_or(0u32) as i64
    if buf[start + 4] != log::KIND_PUT || log::HEADER_LEN + klen + vlen != end - start { return false }
    stored == crc && crc32::update_window(0, buf, start + log::HEADER_LEN, end) == crc
}

// The whole record the hash index names for `key`, checked before it is
// copied.
fn whole_record(st: &mut kv::Store, key: String, e: kv::Entry) -> Result<Vec<u8>, String> {
    let len = log::record_len(key, e.vlen)
    let f = if e.file == st.gen && st.data.is_some() { st.data } else { kv::reader_for(st, e.file) }
    let rec = match f {
        Some(file) => match file.read_at(len, e.offset) {
            Ok(b) => b
            Err(err) => return Err("compact: '" + key + "': " + err.message())
        }
        None => return Err("compact: '" + key + "': generation " + e.file.to_string() + " cannot be opened")
    }
    if !record_holds(rec, 0, rec.len(), e.crc) { return Err("compact: '" + key + "': checksum mismatch") }
    Ok(rec)
}

// Appends `src[start..end]` to the merged generation, writing out what has
// gathered once there is enough of it, and answers where the bytes start.
fn emit(out: &mut Out, src: Vec<u8>, start: i64, end: i64) -> Result<i64, String> {
    let at = out.at + out.buf.len()
    match src.slice(start, end) {
        Ok(part) => out.buf.extend(part)
        Err(e) => return Err("compact: " + e.message())
    }
    if out.buf.len() >= kv::PENDING_FLUSH { flush_out(out)? }
    Ok(at)
}

fn flush_out(out: &mut Out) -> Result<(), String> {
    if out.buf.len() == 0 { return Ok(()) }
    match out.mf.write_at(out.buf, out.at) {
        Ok(n) => {
            if n != out.buf.len() { return Err("compact: short write") }
        }
        Err(e) => return Err("compact: write: " + e.message())
    }
    out.at += out.buf.len()
    out.buf.clear()
    Ok(())
}

// Writes out the hint bytes gathered so far once there are enough of them, so
// a large store's hint is never held whole.
fn flush_hints_due(out: &mut Out) -> Result<(), String> {
    if out.hbuf.len() < HINT_FLUSH { return Ok(()) }
    flush_hint_bytes(out)
}

fn flush_hint_bytes(out: &mut Out) -> Result<(), String> {
    out.hcrc = crc32::update(out.hcrc, out.hbuf)
    out.hoff = flush_hints(out.hf, out.hbuf, out.hoff)?
    out.hbuf.clear()
    Ok(())
}

// One hint record: what the reader needs to place a value without reading it.
fn hint_into(buf: &mut Vec<u8>, key: String, vlen: i64, crc: i64, off: i64) {
    log::push_le(buf, key.byte_len(), 2)
    log::push_le(buf, vlen, 4)
    log::push_le(buf, crc, 4)
    log::push_le(buf, off, 8)
    buf.extend(key.as_bytes())
}

// Closes the merged generation: the commit record a rebuild reads up to, the
// hint's trailer, both files made durable, and the hint moved into place.
//
// The hint file is what seals the generation, so it appears only once the data
// it describes is durable; the fresh active file keeps that seal true.
fn seal(out: &mut Out, hstage: String, hpath: String, dir: String) -> Result<(), String> {
    log::record_into(&mut out.buf, "", log::KIND_COMMIT, #[], log::record_crc("", #[]))
    flush_out(out)?
    // The trailer closes the hint: its record count, then a checksum of every
    // byte before the checksum itself.
    out.hbuf.push(recover::HINT_END)
    log::push_le(&mut out.hbuf, out.hcount, 8)
    out.hcrc = crc32::update(out.hcrc, out.hbuf)
    log::push_le(&mut out.hbuf, out.hcrc, 4)
    out.hoff = flush_hints(out.hf, out.hbuf, out.hoff)?
    out.hbuf.clear()
    if let Err(e) = out.mf.sync_all() { return Err("compact: sync: " + e.message()) }
    if let Err(e) = out.hf.sync_all() { return Err("compact: hint sync: " + e.message()) }
    if let Err(e) = fs::rename(hstage, hpath) { return Err("compact: hint: " + e.message()) }
    // The hint is what seals the generation, so the entry naming it is made
    // durable here rather than left to whatever writes the directory next.
    log::sync_dir(dir)
}

// Opens the generation writes go to after the merge. The readers go with the
// generations they served, which this one replaces.
fn start_active(st: &mut kv::Store, active: i64) -> Result<(), String> {
    st.data = Some(log::open_append(log::data_path(st.dir, active))?)
    log::sync_dir(st.dir)?
    st.gen = active
    st.cur_off = 0
    st.readers = Map::new()
    Ok(())
}

// Removes the generations the merge rewrote; the rest still hold the records
// the index points at.
//
// A generation left behind is replayed at the next open, where it would restore
// the values the merge superseded and the rows it dropped, so a removal that
// does not happen is reported rather than passed over.
fn drop_merged(st: &mut kv::Store, merging: Vec<i64>, merged: i64) -> Result<(), String> {
    for g in merging {
        if g < merged {
            if let Err(e) = fs::remove_file(log::data_path(st.dir, g)) {
                return Err("compact: " + log::data_path(st.dir, g) + ": " + e.message())
            }
            if fs::exists(log::hint_path(st.dir, g)) {
                if let Err(e) = fs::remove_file(log::hint_path(st.dir, g)) {
                    return Err("compact: " + log::hint_path(st.dir, g) + ": " + e.message())
                }
            }
        }
    }
    log::sync_dir(st.dir)
}

#[cfg(test)]
mod tests {
    use std::fs
    use crate::kv

    fn fresh(name: String) -> String {
        let dir = "/tmp/terndb_kv_test/" + name
        let _ = fs::remove_dir_all(dir)
        let _ = fs::create_dir_all(dir)
        dir
    }

    fn opened(dir: String) -> kv::Store {
        kv::open(dir).unwrap_or_else(|e| panic("open " + dir + ": " + e))
    }

    fn must_get(st: &mut kv::Store, key: String) -> Vec<u8> {
        match st.get(key) {
            kv::Read::Value(v) => return v
            kv::Read::Fault(e) => panic(e)
            kv::Read::Absent => {
                assert(false, "expected a value for '" + key + "'")
                return #[]
            }
        }
    }

    // Overwrites eight keys `rounds` times with a payload big enough that the
    // log passes the size a merge is worth doing above.
    fn churn(st: &mut kv::Store, rounds: i64) {
        let payload: Vec<u8> = #[7u8; 8192]
        let mut i: i64 = 0
        while i < rounds * 8 {
            assert(st.put("k/" + (i % 8).to_string(), payload).is_ok())
            i += 1
        }
    }

    #[test]
    fn compaction_keeps_live_data_and_drops_the_rest() {
        let dir = fresh("compact")
        let mut st = opened(dir)
        assert(st.put("keep", #[1u8]).is_ok())
        assert(st.put("keep", #[2u8]).is_ok())
        assert(st.put("drop", #[3u8]).is_ok())
        assert_eq(st.delete("drop").unwrap_or(false), true)
        assert(st.dead_bytes > 0)

        if let Err(e) = kv::compact::run(&mut st) { assert(false, "compact: " + e) }
        assert_eq(must_get(&mut st, "keep"), #[2u8])
        assert(matches(st.get("drop"), kv::Read::Absent))
        assert_eq(st.len(), 1)
        assert_eq(st.dead_bytes, 0, "compaction reclaims every retired byte")

        let mut after = opened(dir)
        assert_eq(must_get(&mut after, "keep"), #[2u8], "the merged generation reloads from its hint")
        assert(matches(after.get("drop"), kv::Read::Absent))
        assert_eq(after.len(), 1)
    }

    #[test]
    fn writes_after_a_compaction_survive_a_restart() {
        let dir = fresh("compact_then_write")
        let mut st = opened(dir)
        assert(st.put("old", #[1u8]).is_ok())
        if let Err(e) = kv::compact::run(&mut st) { assert(false, "compact: " + e) }
        assert(st.put("new", #[2u8]).is_ok())
        assert(st.put("old", #[3u8]).is_ok())
        assert(st.sync().is_ok())

        let mut after = opened(dir)
        assert_eq(must_get(&mut after, "new"), #[2u8], "a post-compaction append is not lost to a stale hint")
        assert_eq(must_get(&mut after, "old"), #[3u8], "the newer value outranks the merged one")
        assert_eq(after.len(), 2)
    }

    #[test]
    fn repeated_compaction_stays_consistent() {
        let dir = fresh("compact_repeat")
        let mut st = opened(dir)
        let mut round: i64 = 0
        while round < 4 {
            let mut i: i64 = 0
            while i < 10 {
                assert(st.put("k" + i.to_string(), #[round as u8, i as u8]).is_ok())
                i += 1
            }
            assert_eq(st.delete("k" + round.to_string()).unwrap_or(false), true)
            if let Err(e) = kv::compact::run(&mut st) { assert(false, "compact round " + round.to_string() + ": " + e) }
            assert_eq(st.len(), 9, "round " + round.to_string())
            round += 1
        }
        let mut after = opened(dir)
        assert_eq(after.len(), 9)
        assert_eq(must_get(&mut after, "k5"), #[3u8, 5u8])
    }

    #[test]
    fn compaction_leaves_only_the_merged_and_active_generations() {
        let dir = fresh("compact_files")
        let mut st = opened(dir)
        assert(st.put("k", #[1u8]).is_ok())
        if let Err(e) = kv::compact::run(&mut st) { assert(false, e) }
        let mut data_files: i64 = 0
        for e in fs::read_dir(dir).unwrap_or(#[]) {
            if e.name.ends_with(".data") { data_files += 1 }
        }
        assert_eq(data_files, 2, "the merged generation plus the fresh active one")
    }

    #[test]
    fn dead_ratio_tracks_the_superseded_share() {
        let mut st = opened(fresh("ratio"))
        assert_eq(super::dead_ratio(&mut st), 0.0, "an empty store has nothing dead")
        assert(st.put("k", #[0u8; 100]).is_ok())
        assert_eq(super::dead_ratio(&mut st), 0.0)
        assert(st.put("k", #[0u8; 100]).is_ok())
        assert(super::dead_ratio(&mut st) > 0.4, "one of two equal records is now dead")
        assert(super::dead_ratio(&mut st) < 0.6)
        if let Err(e) = kv::compact::run(&mut st) { assert(false, e) }
        assert_eq(super::dead_ratio(&mut st), 0.0, "compaction clears the dead share")
    }

    #[test]
    fn a_log_that_is_mostly_superseded_merges_itself() {
        let dir = fresh("auto_compact")
        let mut st = opened(dir)
        churn(&mut st, 20)
        // A generation past the first is one a merge opened.
        assert(st.gen > 1, "the log merged itself, gen is " + st.gen.to_string())
        assert_eq(st.len(), 8)
        let mut j: i64 = 0
        while j < 8 {
            assert_eq(must_get(&mut st, "k/" + j.to_string()).len(), 8192, "key " + j.to_string())
            j += 1
        }
        // Every merged record is still there after a restart.
        assert(st.sync().is_ok())
        let mut after = opened(dir)
        assert_eq(after.len(), 8)
        assert_eq(must_get(&mut after, "k/3").len(), 8192)
    }

    #[test]
    fn a_generation_that_is_still_live_is_not_rewritten_by_a_merge() {
        let dir = fresh("selective_merge")
        let mut st = opened(dir)
        let payload: Vec<u8> = #[7u8; 8192]
        // A cold set, sealed into a generation of its own and never touched again.
        let mut i: i64 = 0
        while i < 160 {
            assert(st.put("cold/" + i.to_string(), payload).is_ok())
            i += 1
        }
        assert(kv::compact::run(&mut st).is_ok())
        let cold_gen = st.gen - 1
        assert(fs::is_file(kv::log::data_path(dir, cold_gen)), "the cold records are sealed in one generation")

        // A hot set churned until the store merges itself.
        let mut h: i64 = 0
        while h < 400 {
            assert(st.put("hot/" + (h % 4).to_string(), payload).is_ok())
            h += 1
        }
        assert(st.gen > cold_gen + 1, "the store merged itself again")
        assert(fs::is_file(kv::log::data_path(dir, cold_gen))
            "a generation with nothing dead in it is left where it is")

        // And every record is still readable, from both sets.
        assert_eq(st.len(), 164)
        assert_eq(must_get(&mut st, "cold/0").len(), 8192)
        assert_eq(must_get(&mut st, "cold/159").len(), 8192)
        assert_eq(must_get(&mut st, "hot/3").len(), 8192)
        assert(st.sync().is_ok())
        let mut after = opened(dir)
        assert_eq(after.len(), 164)
        assert_eq(must_get(&mut after, "cold/80").len(), 8192)
        assert_eq(must_get(&mut after, "hot/1").len(), 8192)
    }

    #[test]
    fn an_explicit_merge_still_rewrites_the_whole_store() {
        let dir = fresh("full_merge")
        let mut st = opened(dir)
        kv::compact::set_ratio(&mut st, 0.0)
        let payload: Vec<u8> = #[7u8; 4096]
        let mut i: i64 = 0
        while i < 40 {
            assert(st.put("cold/" + i.to_string(), payload).is_ok())
            i += 1
        }
        assert(kv::compact::run(&mut st).is_ok())
        let cold_gen = st.gen - 1
        assert(st.put("hot", payload).is_ok())
        // COMPACT means the whole store, so the clean generation goes too.
        assert(kv::compact::run(&mut st).is_ok())
        assert(!fs::is_file(kv::log::data_path(dir, cold_gen)), "an explicit merge leaves nothing behind")
        assert_eq(st.len(), 41)
        assert_eq(must_get(&mut st, "cold/7").len(), 4096)
        assert_eq(super::dead_ratio(&mut st), 0.0)
    }

    #[test]
    fn merging_is_the_callers_business_when_it_is_turned_off() {
        let dir = fresh("no_auto_compact")
        let mut st = opened(dir)
        kv::compact::set_ratio(&mut st, 0.0)
        churn(&mut st, 20)
        assert_eq(st.gen, 1, "nothing merged the log")
        assert(super::dead_ratio(&mut st) > 0.5)
        assert_eq(st.len(), 8)
        assert(kv::compact::run(&mut st).is_ok())
        assert_eq(super::dead_ratio(&mut st), 0.0)
        assert_eq(st.len(), 8)
        assert_eq(must_get(&mut st, "k/5").len(), 8192)
    }

    #[test]
    fn a_small_store_does_not_merge_on_every_overwrite() {
        let mut st = opened(fresh("small_no_compact"))
        let mut i: i64 = 0
        while i < 40 {
            assert(st.put("k", #[1u8, 2u8, 3u8]).is_ok())
            i += 1
        }
        assert_eq(st.gen, 1, "a store this small is left alone")
        assert(super::dead_ratio(&mut st) > 0.9)
        assert_eq(st.len(), 1)
    }

    // A table written back to front, with a few keys beside it, so the merge
    // has both kinds of index entry to move and a layout to put right.
    fn backwards(dir: String) -> kv::Store {
        let mut st = opened(dir)
        let tid = kv::rows::open_table(&mut st, "t")
        let mut rid: i64 = 60
        while rid >= 1 {
            assert(kv::rows::write(&mut st, tid, rid, ("row-" + rid.to_string()).as_bytes()).is_ok())
            rid -= 1
        }
        assert(st.put("schema/t", #[1u8, 2]).is_ok())
        assert(st.put("other", #[3u8]).is_ok())
        assert_eq(kv::rows::remove(&mut st, tid, 7).unwrap_or(false), true)
        st
    }

    // The dense index of table `t` and the hash index, as words and keys, for
    // comparing what two opens built.
    fn index_of(st: &mut kv::Store) -> (Vec<i64>, Vec<String>) {
        let tid = kv::rows::table_id(st, "t")
        let mut keys: Vec<String> = #[]
        for k in st.index.keys() {
            let e = st.index.get(k).unwrap_or(kv::Entry { file: 0, offset: 0, vlen: 0, crc: 0 })
            keys.push(k + "@" + e.file.to_string() + ":" + e.offset.to_string() + ":" + e.vlen.to_string() + ":" + e.crc.to_string())
        }
        keys.sort()
        (st.tables[tid].slots, keys)
    }

    #[test]
    fn a_merge_lays_each_table_out_in_row_id_order() {
        let dir = fresh("compact_row_order")
        let mut st = backwards(dir)
        assert(super::run(&mut st).is_ok())
        let tid = kv::rows::table_id(&mut st, "t")
        let mut last: i64 = -1
        for rid in 1..61 {
            if rid == 7 { continue }
            let at = kv::log::loc_offset(st.tables[tid].slots[3 * rid])
            assert(at > last, "row " + rid.to_string() + " follows the row before it")
            last = at
            assert_eq(kv::rows::read(&mut st, tid, rid), kv::Read::Value(("row-" + rid.to_string()).as_bytes()))
        }
        assert(matches(kv::rows::read(&mut st, tid, 7), kv::Read::Absent))
        assert_eq(st.len(), 61)
    }

    #[test]
    fn a_merge_refuses_a_record_whose_header_was_damaged() {
        let dir = fresh("compact_bad_header")
        let mut st = opened(dir)
        let tid = kv::rows::open_table(&mut st, "t")
        assert(kv::rows::write(&mut st, tid, 1, #[1u8, 2, 3]).is_ok())
        assert(kv::rows::write(&mut st, tid, 2, #[4u8, 5, 6]).is_ok())
        let path = kv::log::data_path(dir, st.gen)
        let mut bytes = fs::read(path).unwrap_or(#[])
        // The first record's key starts right after its header; its value, and
        // so the checksum a read makes, is left alone.
        bytes[kv::log::HEADER_LEN] = bytes[kv::log::HEADER_LEN] + 1u8
        assert(fs::write(path, bytes).is_ok())
        match super::run(&mut st) {
            Ok(()) => assert(false, "a damaged record is not copied into the merge")
            Err(e) => assert(e.contains("header"), "got: " + e)
        }
        assert_eq(kv::rows::read(&mut st, tid, 2), kv::Read::Value(#[4u8, 5, 6]), "the store is as it was")
    }

    #[test]
    fn a_hint_builds_the_index_the_data_file_builds() {
        let dir = fresh("hint_matches_data")
        let mut st = backwards(dir)
        assert(super::run(&mut st).is_ok())
        let merged = st.gen - 1
        let mut from_hint = opened(dir)
        let want = index_of(&mut from_hint)
        let hint = kv::log::hint_path(dir, merged)
        let saved = fs::read(hint).unwrap_or(#[])
        assert(saved.len() > 0)
        assert(fs::remove_file(hint).is_ok())
        let mut from_data = opened(dir)
        assert_eq(index_of(&mut from_data), want, "the data file agrees with its hint")
        assert(fs::write(hint, saved).is_ok())
    }

    #[test]
    fn a_hint_that_is_not_whole_is_answered_by_the_data_file() {
        let dir = fresh("hint_damaged")
        let mut st = backwards(dir)
        assert(super::run(&mut st).is_ok())
        let merged = st.gen - 1
        let hint = kv::log::hint_path(dir, merged)
        let good = fs::read(hint).unwrap_or(#[])
        let mut reference = opened(dir)
        let want = index_of(&mut reference)
        let mut truncated = good.slice(0, good.len() - 9).unwrap_or(#[])
        let mut flipped = good
        flipped[good.len() / 2] = flipped[good.len() / 2] + 1u8
        let mut unmarked = good
        unmarked[0] = 88u8
        for (name, bytes) in #[("truncated", truncated), ("flipped", flipped), ("unmarked", unmarked)] {
            assert(fs::write(hint, bytes).is_ok())
            let mut after = opened(dir)
            assert_eq(index_of(&mut after), want, name)
            assert_eq(after.len(), 61, name)
        }
    }

    #[test]
    fn a_hint_in_the_older_flat_form_still_opens() {
        let dir = fresh("hint_flat")
        let mut st = backwards(dir)
        assert(super::run(&mut st).is_ok())
        let merged = st.gen - 1
        let want = index_of(&mut st)
        // What 0.2.0 wrote: one flat record per key, and nothing around them.
        let mut flat: Vec<u8> = #[]
        for k in kv::scan::keys(&mut st, "") {
            let tid, rid = kv::rows::locate_row(&mut st, k)
            if tid >= 0 {
                let s = 3 * rid
                super::hint_into(&mut flat, k, kv::log::loc_vlen(st.tables[tid].slots[s])
                    kv::log::gc_crc(st.tables[tid].slots[s + 1]), kv::log::loc_offset(st.tables[tid].slots[s]))
            } else {
                let e = st.index.get(k).unwrap_or(kv::Entry { file: 0, offset: 0, vlen: 0, crc: 0 })
                super::hint_into(&mut flat, k, e.vlen, e.crc, e.offset)
            }
        }
        assert(fs::write(kv::log::hint_path(dir, merged), flat).is_ok())
        let mut after = opened(dir)
        assert_eq(index_of(&mut after), want)
        assert_eq(after.faults, #[])
    }
}
