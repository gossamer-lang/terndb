use std::encoding::binary

// terndb value codec: a tag byte followed by a fixed-width little-endian payload.
//
//   0 nil       1 byte      5 i64       1 + 8
//   1 bool      1 + 1       6 f32       1 + 8
//   2 i8        1 + 1       7 f64       1 + 8
//   3 i16       1 + 2       8 text      1 + 4 (u32 byte length) + UTF-8 bytes
//   4 i32       1 + 4       9 datetime  1 + 8 (epoch millis, UTC)
//
// Integers are written through the signed `put_*_le` family and read back
// through the unsigned `get_*_le_at` family, so a value crosses the encoding
// boundary only in the u->i direction. f32 stores the f64 bit pattern of the
// f32-rounded value: that rounding is idempotent, so the extra four bytes buy
// an exact round-trip without a 32-bit bit-cast.
//
// A value's JSON spelling is [`json`]; the calendar arithmetic a datetime is
// written and read with is [`datetime`].

pub const TAG_NIL: u8 = 0
pub const TAG_BOOL: u8 = 1
pub const TAG_I8: u8 = 2
pub const TAG_I16: u8 = 3
pub const TAG_I32: u8 = 4
pub const TAG_I64: u8 = 5
pub const TAG_F32: u8 = 6
pub const TAG_F64: u8 = 7
pub const TAG_TEXT: u8 = 8
pub const TAG_DT: u8 = 9

/// A `?` placeholder in a prepared statement. Never encoded: a bound value
/// replaces it before the statement runs.
pub const TAG_PARAM: u8 = 10

/// A single column value: the tag selects which payload field is meaningful.
pub struct Value {
    pub tag: u8
    pub b: bool
    pub i: i64
    pub f: f64
    pub s: String
}

impl Value {
    /// The NULL value.
    pub fn nil() -> Value { Value { tag: TAG_NIL, b: false, i: 0, f: 0.0, s: "" } }

    /// A boolean value.
    pub fn bool(v: bool) -> Value { Value { tag: TAG_BOOL, b: v, i: 0, f: 0.0, s: "" } }

    /// A text value.
    pub fn text(v: String) -> Value { Value { tag: TAG_TEXT, b: false, i: 0, f: 0.0, s: v } }

    /// A 64-bit signed integer value, which is what an integer literal is.
    pub fn int(v: i64) -> Value { Value { tag: TAG_I64, b: false, i: v, f: 0.0, s: "" } }

    /// A 64-bit float value, which is what a decimal literal is.
    pub fn float(v: f64) -> Value { Value { tag: TAG_F64, b: false, i: 0, f: v, s: "" } }

    /// A datetime value, as milliseconds since the Unix epoch in UTC.
    pub fn datetime(ms: i64) -> Value { Value { tag: TAG_DT, b: false, i: ms, f: 0.0, s: "" } }

    /// An 8-bit signed integer value.
    pub fn int8(v: i64) -> Value { Value { tag: TAG_I8, b: false, i: v, f: 0.0, s: "" } }

    /// A 16-bit signed integer value.
    pub fn int16(v: i64) -> Value { Value { tag: TAG_I16, b: false, i: v, f: 0.0, s: "" } }

    /// A 32-bit signed integer value.
    pub fn int32(v: i64) -> Value { Value { tag: TAG_I32, b: false, i: v, f: 0.0, s: "" } }

    /// A 32-bit float value, rounded to f32 precision on construction.
    pub fn float32(v: f64) -> Value { Value { tag: TAG_F32, b: false, i: 0, f: (v as f32) as f64, s: "" } }

    /// The `n`th `?` placeholder of a prepared statement, counting from zero.
    pub fn param(n: i64) -> Value { Value { tag: TAG_PARAM, b: false, i: n, f: 0.0, s: "" } }
}

// A value renders the way the CLI prints it, so `{}` on a value, on a row of
// them, or on anything holding one all answer the same text.
impl Display for Value {
    fn fmt(&self) -> String {
        if self.tag == TAG_NIL { return "NULL" }
        if self.tag == TAG_BOOL { return self.b.to_string() }
        if self.tag == TAG_TEXT { return self.s }
        if self.tag == TAG_F32 || self.tag == TAG_F64 { return self.f.to_string() }
        if self.tag == TAG_DT { return datetime::render(self.i) }
        self.i.to_string()
    }
}

/// The inclusive value range a fixed-width integer tag can hold, or None for other tags.
pub fn int_range(tag: u8) -> Option<(i64, i64)> {
    match tag {
        TAG_I8 => Some((-128, 127))
        TAG_I16 => Some((-32_768, 32_767))
        TAG_I32 => Some((-2_147_483_648, 2_147_483_647))
        TAG_I64 | TAG_DT => Some((-9_223_372_036_854_775_807 - 1, 9_223_372_036_854_775_807))
        _ => None
    }
}

/// The column type tag a CREATE TABLE type name selects, or 0 if unknown.
pub fn tag_for_type_name(name: String) -> u8 {
    match name.to_uppercase() {
        "BOOL" | "BOOLEAN" => TAG_BOOL
        "INT8" | "I8" | "TINYINT" => TAG_I8
        "INT16" | "I16" | "SMALLINT" => TAG_I16
        "INT32" | "I32" | "INT" | "INTEGER" => TAG_I32
        "INT64" | "I64" | "BIGINT" => TAG_I64
        "FLOAT32" | "F32" | "REAL" => TAG_F32
        "FLOAT64" | "F64" | "FLOAT" | "DOUBLE" => TAG_F64
        "TEXT" | "STRING" | "VARCHAR" => TAG_TEXT
        "DATETIME" | "TIMESTAMP" => TAG_DT
        _ => 0
    }
}

/// The canonical type name for a tag, as CREATE TABLE would spell it.
pub fn type_name_for_tag(tag: u8) -> String {
    match tag {
        TAG_PARAM => "PARAMETER"
        TAG_BOOL => "BOOL"
        TAG_I8 => "INT8"
        TAG_I16 => "INT16"
        TAG_I32 => "INT32"
        TAG_I64 => "INT64"
        TAG_F32 => "FLOAT32"
        TAG_F64 => "FLOAT64"
        TAG_TEXT => "TEXT"
        TAG_DT => "DATETIME"
        _ => "NULL"
    }
}

/// Appends the encoding of `v` to `buf`.
///
/// Writing through the caller's buffer is what keeps encoding a row linear: a
/// fresh Vec per column, joined afterwards, copies every earlier column again.
pub fn encode_into(buf: &mut Vec<u8>, v: Value) {
    buf.push(v.tag)
    if v.tag == TAG_BOOL {
        buf.push(if v.b { 1u8 } else { 0u8 })
        return
    }
    if v.tag == TAG_I8 {
        buf.push((v.i & 0xFF) as u8)
        return
    }
    if v.tag == TAG_I16 {
        buf.extend(binary::put_u16_le(#[], v.i))
        return
    }
    if v.tag == TAG_I32 {
        buf.extend(binary::put_u32_le(#[], v.i))
        return
    }
    if v.tag == TAG_I64 || v.tag == TAG_DT {
        buf.extend(binary::put_u64_le(#[], v.i))
        return
    }
    if v.tag == TAG_F32 || v.tag == TAG_F64 {
        buf.extend(binary::put_u64_le(#[], v.f.to_bits() as i64))
        return
    }
    if v.tag == TAG_TEXT {
        let bytes = v.s.as_bytes()
        buf.extend(binary::put_u32_le(#[], bytes.len()))
        buf.extend(bytes)
    }
}

/// Encodes a value as its tag byte followed by its payload.
pub fn encode(v: Value) -> Vec<u8> {
    let mut buf: Vec<u8> = #[]
    encode_into(&mut buf, v)
    buf
}

// Payload width for the fixed-width tags, or 0 for nil and text.
fn payload_width(tag: u8) -> i64 {
    match tag {
        TAG_BOOL | TAG_I8 => 1
        TAG_I16 => 2
        TAG_I32 => 4
        TAG_I64 | TAG_DT | TAG_F32 | TAG_F64 => 8
        _ => 0
    }
}

// Decodes one value and reports, through `next`, where the one after it starts.
fn decode_at(buf: Vec<u8>, pos: i64, next: &mut i64) -> Result<Value, String> {
    if pos < 0 || pos >= buf.len() { return Err("decode: no tag byte at " + pos.to_string()) }
    let tag = buf[pos]
    let p = pos + 1
    if tag == TAG_NIL {
        *next = p
        return Ok(Value::nil())
    }
    let width = payload_width(tag)
    if width > 0 {
        if p + width > buf.len() {
            return Err("decode: truncated " + width.to_string() + "-byte payload at " + p.to_string())
        }
        *next = p + width
        return decode_fixed(buf, p, tag)
    }
    if tag == TAG_TEXT { return decode_text(buf, p, next) }
    Err("decode: unknown tag " + tag.to_string())
}

// A fixed-width payload, whose bytes the caller has already established are
// there.
fn decode_fixed(buf: Vec<u8>, p: i64, tag: u8) -> Result<Value, String> {
    if tag == TAG_BOOL { return Ok(Value::bool(buf[p] != 0u8)) }
    if tag == TAG_I8 { return Ok(Value::int8(buf[p] as i8 as i64)) }
    if tag == TAG_I16 {
        match binary::get_u16_le_at(buf, p) {
            Ok(x) => return Ok(Value::int16(x as i16 as i64))
            Err(e) => return Err("decode: " + e.message())
        }
    }
    if tag == TAG_I32 {
        match binary::get_u32_le_at(buf, p) {
            Ok(x) => return Ok(Value::int32(x as i32 as i64))
            Err(e) => return Err("decode: " + e.message())
        }
    }
    match binary::get_u64_le_at(buf, p) {
        Ok(bits) => {
            if tag == TAG_I64 { return Ok(Value::int(bits as i64)) }
            if tag == TAG_DT { return Ok(Value::datetime(bits as i64)) }
            if tag == TAG_F32 { return Ok(Value::float32(f64::from_bits(bits))) }
            Ok(Value::float(f64::from_bits(bits)))
        }
        Err(e) => Err("decode: " + e.message())
    }
}

// A text payload: a u32 byte length and that many bytes of UTF-8.
fn decode_text(buf: Vec<u8>, p: i64, next: &mut i64) -> Result<Value, String> {
    let n = match binary::get_u32_le_at(buf, p) {
        Ok(x) => x as i64
        Err(e) => return Err("decode: truncated text length: " + e.message())
    }
    let start = p + 4
    let bytes = match buf.slice(start, start + n) {
        Ok(b) => b
        Err(_) => return Err("decode: truncated text body")
    }
    *next = start + n
    match String::from_utf8(bytes) {
        Ok(text) => Ok(Value::text(text))
        Err(e) => Err("decode: text is not UTF-8: " + e.message())
    }
}

/// Decodes the value starting at `pos`, or reports why the buffer cannot hold one.
pub fn decode(buf: Vec<u8>, pos: i64) -> Result<Value, String> {
    let mut next: i64 = 0
    decode_at(buf, pos, &mut next)
}

/// Decodes `count` values from the start of `buf` into `out`, replacing what it
/// held, and answers whether the buffer holds them.
///
/// The caller's buffer is filled rather than a fresh one returned, for a read
/// path that answers one row at a time and has somewhere to put it.
pub fn decode_row_into(buf: Vec<u8>, count: i64, out: &mut Vec<Value>) -> bool {
    out.clear()
    let mut p: i64 = 0
    let mut i: i64 = 0
    while i < count {
        let mut next: i64 = 0
        match decode_at(buf, p, &mut next) {
            Ok(v) => out.push(v)
            Err(_) => return false
        }
        p = next
        i += 1
    }
    true
}

/// Decodes `count` values laid out back to back from the start of `buf`.
pub fn decode_row(buf: Vec<u8>, count: i64) -> Result<Vec<Value>, String> {
    let mut vals: Vec<Value> = #[]
    let mut p: i64 = 0
    let mut i: i64 = 0
    while i < count {
        let mut next: i64 = 0
        vals.push(decode_at(buf, p, &mut next)?)
        p = next
        i += 1
    }
    Ok(vals)
}

/// Total encoded byte length of a value, tag byte included.
pub fn encoded_len(v: Value) -> i64 {
    if v.tag == TAG_NIL { return 1 }
    if v.tag == TAG_BOOL || v.tag == TAG_I8 { return 2 }
    if v.tag == TAG_I16 { return 3 }
    if v.tag == TAG_I32 { return 5 }
    if v.tag == TAG_TEXT { return 5 + v.s.byte_len() }
    9
}

#[cfg(test)]
mod tests {
    fn roundtrip(v: super::Value) -> super::Value {
        let bytes = super::encode(v)
        assert_eq(bytes.len(), super::encoded_len(v), "encoded_len must match encode() output")
        match super::decode(bytes, 0) {
            Ok(d) => return d
            Err(e) => {
                assert(false, "decode failed: " + e)
                return super::Value::nil()
            }
        }
    }

    #[test]
    fn every_tag_survives_a_roundtrip() {
        assert_eq(roundtrip(super::Value::nil()).tag, super::TAG_NIL)
        assert_eq(roundtrip(super::Value::bool(true)).b, true)
        assert_eq(roundtrip(super::Value::bool(false)).b, false)
        assert_eq(roundtrip(super::Value::int8(-5)).i, -5)
        assert_eq(roundtrip(super::Value::int16(300)).i, 300)
        assert_eq(roundtrip(super::Value::int32(-70_000)).i, -70_000)
        assert_eq(roundtrip(super::Value::int(1_234_567_890_123)).i, 1_234_567_890_123)
        assert_eq(roundtrip(super::Value::float(-2.25)).f, -2.25)
        assert_eq(roundtrip(super::Value::text("hello")).s, "hello")
        assert_eq(roundtrip(super::Value::datetime(1_700_000_000_123)).i, 1_700_000_000_123)
    }

    #[test]
    fn integer_extremes_survive_a_roundtrip() {
        assert_eq(roundtrip(super::Value::int8(-128)).i, -128)
        assert_eq(roundtrip(super::Value::int8(127)).i, 127)
        assert_eq(roundtrip(super::Value::int16(-32_768)).i, -32_768)
        assert_eq(roundtrip(super::Value::int16(32_767)).i, 32_767)
        assert_eq(roundtrip(super::Value::int32(-2_147_483_648)).i, -2_147_483_648)
        assert_eq(roundtrip(super::Value::int32(2_147_483_647)).i, 2_147_483_647)
        assert_eq(roundtrip(super::Value::int(9_223_372_036_854_775_807)).i, 9_223_372_036_854_775_807)
        assert_eq(roundtrip(super::Value::int(-9_223_372_036_854_775_807 - 1)).i, -9_223_372_036_854_775_807 - 1)
    }

    #[test]
    fn f32_values_roundtrip_exactly() {
        assert_eq(roundtrip(super::Value::float32(1.5)).f, 1.5)
        assert_eq(roundtrip(super::Value::float32(-0.25)).f, -0.25)
        // The f32 rounding a Value::float32 applies is idempotent, so it survives storage.
        let rounded = super::Value::float32(0.1)
        assert_eq(roundtrip(rounded).f, rounded.f)
        assert_eq(roundtrip(super::Value::float(0.1)).f, 0.1)
    }

    #[test]
    fn text_roundtrips_multibyte_utf8() {
        let s = "héllo wörld"
        let v = super::Value::text(s)
        assert_eq(super::encoded_len(v), 5 + 13, "length prefix counts bytes, not characters")
        assert_eq(roundtrip(v).s, s)
        assert_eq(roundtrip(super::Value::text("")).s, "")
        assert_eq(roundtrip(super::Value::text("日本語 🌍")).s, "日本語 🌍")
    }

    #[test]
    fn values_decode_back_to_back_from_one_buffer() {
        let vals = #[
            super::Value::nil(), super::Value::bool(true), super::Value::int8(-5), super::Value::int16(300)
            super::Value::int32(-70_000), super::Value::int(1_234_567_890_123), super::Value::float32(1.5)
            super::Value::float(-2.25), super::Value::text("héllo wörld"), super::Value::datetime(1_700_000_000_123)
        ]
        let mut packed: Vec<u8> = #[]
        for v in vals { super::encode_into(&mut packed, v) }
        let mut pos: i64 = 0
        for i in 0..vals.len() {
            match super::decode(packed, pos) {
                Ok(got) => {
                    assert_eq(got.tag, vals[i].tag, "tag at index " + i.to_string())
                    assert_eq(got.i, vals[i].i, "int payload at index " + i.to_string())
                    assert_eq(got.f, vals[i].f, "float payload at index " + i.to_string())
                    assert_eq(got.s, vals[i].s, "text payload at index " + i.to_string())
                    assert_eq(got.b, vals[i].b, "bool payload at index " + i.to_string())
                    pos += super::encoded_len(got)
                }
                Err(e) => assert(false, "decode at " + pos.to_string() + ": " + e)
            }
        }
        assert_eq(pos, packed.len(), "the values must consume the whole buffer")
    }

    #[test]
    fn decode_rejects_a_truncated_buffer() {
        let full = super::encode(super::Value::int(1_234_567_890_123))
        let mut i: i64 = 1
        while i < full.len() {
            let short = full.slice(0, i).unwrap_or(#[])
            assert(super::decode(short, 0).is_err(), "a " + i.to_string() + "-byte prefix must not decode")
            i += 1
        }
        assert(super::decode(#[], 0).is_err(), "an empty buffer has no tag")
        assert(super::decode(#[200u8], 0).is_err(), "tag 200 is not a known tag")
    }

    #[test]
    fn decode_rejects_text_that_is_not_utf8() {
        let mut bad = #[super::TAG_TEXT]
        bad.extend(#[2u8, 0u8, 0u8, 0u8])
        bad.extend(#[0xC3u8, 0x28u8])
        assert(super::decode(bad, 0).is_err(), "0xC3 0x28 is not a valid UTF-8 sequence")
    }

    #[test]
    fn type_names_map_to_tags_case_insensitively() {
        assert_eq(super::tag_for_type_name("text"), super::TAG_TEXT)
        assert_eq(super::tag_for_type_name("TEXT"), super::TAG_TEXT)
        assert_eq(super::tag_for_type_name("Int32"), super::TAG_I32)
        assert_eq(super::tag_for_type_name("bigint"), super::TAG_I64)
        assert_eq(super::tag_for_type_name("DATETIME"), super::TAG_DT)
        assert_eq(super::tag_for_type_name("float"), super::TAG_F64)
        assert_eq(super::tag_for_type_name("real"), super::TAG_F32)
        assert_eq(super::tag_for_type_name("blob"), 0u8, "unknown type names map to 0")
    }

    #[test]
    fn type_names_survive_a_tag_roundtrip() {
        let tags = #[
            super::TAG_BOOL, super::TAG_I8, super::TAG_I16, super::TAG_I32
            super::TAG_I64, super::TAG_F32, super::TAG_F64, super::TAG_TEXT, super::TAG_DT
        ]
        for t in tags {
            assert_eq(super::tag_for_type_name(super::type_name_for_tag(t)), t)
        }
    }

    #[test]
    fn values_render_the_way_the_cli_prints_them() {
        assert_eq(super::Value::nil().to_string(), "NULL")
        assert_eq(super::Value::bool(true).to_string(), "true")
        assert_eq(super::Value::int32(-70_000).to_string(), "-70000")
        assert_eq(super::Value::float(9.5).to_string(), "9.5")
        assert_eq(super::Value::text("hi").to_string(), "hi")
        assert_eq(super::Value::datetime(0).to_string(), "1970-01-01T00:00:00.000Z")
    }

    #[test]
    fn int_range_bounds_each_fixed_width_tag() {
        let lo, hi = super::int_range(super::TAG_I8).unwrap_or((0, 0))
        assert_eq(lo, -128)
        assert_eq(hi, 127)
        assert(super::int_range(super::TAG_TEXT).is_none())
        assert(super::int_range(super::TAG_F64).is_none())
    }
}
