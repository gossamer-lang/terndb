use crate::codec
use super::lexer

// The shape of a statement: the same statement with every literal a plan can
// take as an argument replaced by `?`.
//
// The scan mirrors the lexer's rules rather than reusing it, because a shape is
// wanted per request and a token stream is not: this walks the bytes once and
// writes the shape as it goes.

/// The shape of `src` with every literal a plan can take as an argument
/// replaced by `?`, and those literals appended to `args` in the order they
/// appear.
///
/// Two statements differing only in their literals share one shape, so a plan
/// prepared for the first answers the second and a store parses once per shape
/// rather than once per request. The scan mirrors the lexer's rules - comments,
/// quote escapes, and the one place a `-` opens a negative literal - so a
/// statement the lexer accepts normalises to one the lexer accepts.
///
/// A `LIMIT` or `OFFSET` count stays where it is, because the grammar takes an
/// integer there rather than a placeholder. Runs of whitespace collapse to one space,
/// which two spellings of one statement then share. Anything the scan cannot
/// make sense of is returned as it came with `args` emptied, so the parser
/// reports it exactly as it would have.
pub fn normalize(src: String, args: &mut Vec<codec::Value>) -> String {
    let n = src.byte_len()
    let mut out = String::with_capacity(n)
    let mut i: i64 = 0
    // Whether a `-` here opens a negative literal, which is what the lexer asks
    // `value_may_follow` and answers from the token before it.
    let mut sign_ok = true
    // Whether the word just emitted was LIMIT or OFFSET, whose count is not a
    // placeholder.
    let mut after_limit = false
    // Whitespace and comments are one separator however they are spelled, so
    // the space is written when the next token needs one rather than where it
    // was found.
    let mut pending_space = false
    while i < n {
        let b = src.byte_at(i)
        if is_space_byte(b) || opens_comment(src, i, n) {
            i = skip_separator(src, i, n)
            pending_space = true
            continue
        }
        if pending_space {
            if out.byte_len() > 0 { out.push_str(" ") }
            pending_space = false
        }
        if b == 39 {
            i = take_quoted(src, i, &mut out, args)
            if i < 0 { return unshaped(src, args) }
            sign_ok = false
            after_limit = false
            continue
        }
        if is_ident_start_byte(b) {
            let end = word_end(src, i)
            let word = src.substring(i, end)
            out.push_str(word)
            i = end
            sign_ok = word_is(word, "BY")
            after_limit = word_is(word, "LIMIT") || word_is(word, "OFFSET")
            continue
        }
        if opens_number(src, i, n, sign_ok) {
            i = take_number(src, i, after_limit, &mut out, args)
            if i < 0 { return unshaped(src, args) }
            sign_ok = false
            after_limit = false
            continue
        }
        if b > 127 { return unshaped(src, args) }
        if (b == 60 || b == 62 || b == 33) && i + 1 < n && src.byte_at(i + 1) == 61 {
            out.push_str(two_byte_op(b))
            i += 2
            sign_ok = true
            after_limit = false
            continue
        }
        let mark = punct_text(b)
        if mark == "" { return unshaped(src, args) }
        out.push_str(mark)
        // A value may follow every punctuation mark this grammar has except a
        // closing paren and a star, which is what the lexer decides from.
        sign_ok = b != 41 && b != 42 && b != 63
        after_limit = false
        i += 1
    }
    out
}

// Whether a `--` comment opens at `i`.
fn opens_comment(src: String, i: i64, n: i64) -> bool {
    src.byte_at(i) == 45 && i + 1 < n && src.byte_at(i + 1) == 45
}

// Past the run of whitespace and comments at `i`, which together are one
// separator however they are spelled.
fn skip_separator(src: String, i: i64, n: i64) -> i64 {
    let mut p = i
    loop {
        while p < n && is_space_byte(src.byte_at(p)) { p += 1 }
        if !opens_comment(src, p, n) { return p }
        while p < n && src.byte_at(p) != 10 { p += 1 }
    }
}

// Whether a numeric literal opens at `i`. A `-` is a sign only where the token
// before it leaves room for a value.
fn opens_number(src: String, i: i64, n: i64, sign_ok: bool) -> bool {
    let b = src.byte_at(i)
    if is_digit_byte(b) { return true }
    if i + 1 >= n || !is_digit_byte(src.byte_at(i + 1)) { return false }
    (b == 45 && sign_ok) || b == 46
}

// The quoted literal at `i`: its text into `args`, a `?` into `out`, and the
// index just past its closing quote, or -1 when it never closes.
fn take_quoted(src: String, i: i64, out: &mut String, args: &mut Vec<codec::Value>) -> i64 {
    let n = src.byte_len()
    let start = i + 1
    let mut j = start
    let mut plain = true
    while j < n {
        let cb = src.byte_at(j)
        if cb == 92 {
            plain = false
            j += 2
            continue
        }
        if cb == 39 {
            // A doubled quote is the SQL spelling of a literal quote.
            if j + 1 < n && src.byte_at(j + 1) == 39 {
                plain = false
                j += 2
                continue
            }
            let raw = src.substring(start, j)
            args.push(codec::Value::text(if plain { raw } else { unquote(raw) }))
            out.push_str("?")
            return j + 1
        }
        j += 1
    }
    -1
}

// Where the identifier at `i` ends. The word itself is cut by the caller, which
// needs it anyway: the word decides how the token after it reads.
fn word_end(src: String, i: i64) -> i64 {
    let n = src.byte_len()
    let mut p = i
    while p < n && is_ident_part_byte(src.byte_at(p)) { p += 1 }
    p
}

// The numeric literal at `i`: into `args` with a `?` in its place, or copied
// through when it is the count of a LIMIT or an OFFSET, which the grammar takes as an
// integer rather than a placeholder. -1 for a number too wide to read.
fn take_number(src: String, i: i64, keep: bool, out: &mut String, args: &mut Vec<codec::Value>) -> i64 {
    let n = src.byte_len()
    let start = i
    let mut p = if src.byte_at(i) == 45 { i + 1 } else { i }
    let mut isfloat = false
    while p < n {
        let cb = src.byte_at(p)
        if is_digit_byte(cb) {
            p += 1
        } else if cb == 46 && !isfloat {
            isfloat = true
            p += 1
        } else {
            break
        }
    }
    let text = src.substring(start, p)
    if keep {
        out.push_str(text)
        return p
    }
    if isfloat {
        // A number the shape cannot read is one the plan would be built around
        // wrongly, so the statement is handed to the parser as it was written.
        match text.to_f64() {
            Some(v) => args.push(codec::Value::float(v))
            None => return -1
        }
    } else {
        match text.to_i64() {
            Some(v) => args.push(codec::Value::int(v))
            None => return -1
        }
    }
    out.push_str("?")
    p
}

// The statement as it came, with nothing collected from it: the parser answers
// for a statement the scan cannot shape.
fn unshaped(src: String, args: &mut Vec<codec::Value>) -> String {
    args.clear()
    src
}

// A quoted literal's text, for the literals that carry an escape. The plain
// ones are their own text and never reach here.
fn unquote(raw: String) -> String {
    let n = raw.len()
    let mut out = String::with_capacity(raw.byte_len())
    let mut i: i64 = 0
    while i < n {
        let c = raw[i]
        if c == '\'' && i + 1 < n && raw[i + 1] == '\'' {
            out.push_str("'")
            i += 2
            continue
        }
        if c == '\\' && i + 1 < n {
            out.push_str(lexer::unescape(raw[i + 1]).to_string())
            i += 2
            continue
        }
        out.push_str(c.to_string())
        i += 1
    }
    out
}

// The one-character token a punctuation byte stands for, or the empty string
// for a byte the lexer has no token for. Answering a literal is what keeps the
// scan from cutting a fresh String out of the source per character.
fn punct_text(b: i64) -> String {
    match b {
        40 => "("
        41 => ")"
        44 => ","
        42 => "*"
        61 => "="
        60 => "<"
        62 => ">"
        63 => "?"
        59 => ";"
        _ => ""
    }
}

// Whether `w` is `kw` ignoring ASCII case, without building a second string.
fn word_is(w: String, kw: String) -> bool {
    let n = w.byte_len()
    if n != kw.byte_len() { return false }
    let mut i: i64 = 0
    while i < n {
        if fold(w.byte_at(i)) != fold(kw.byte_at(i)) { return false }
        i += 1
    }
    true
}

// The two-character comparison a byte opens when `=` follows it.
fn two_byte_op(b: i64) -> String {
    match b {
        60 => "<="
        62 => ">="
        _ => "!="
    }
}

fn fold(b: i64) -> i64 { if b >= 65 && b <= 90 { b + 32 } else { b } }

fn is_space_byte(b: i64) -> bool { b == 32 || b == 9 || b == 10 || b == 13 }

fn is_digit_byte(b: i64) -> bool { b >= 48 && b <= 57 }

fn is_ident_start_byte(b: i64) -> bool { (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95 }

fn is_ident_part_byte(b: i64) -> bool { is_ident_start_byte(b) || is_digit_byte(b) }

#[cfg(test)]
mod tests {
    use crate::sql::parser

    // The shape a statement normalises to, with the literals it gave up.
    fn shape_of(src: String) -> (String, Vec<codec::Value>) {
        let mut args: Vec<codec::Value> = #[]
        let shape = super::normalize(src, &mut args)
        (shape, args)
    }

    #[test]
    fn normalize_spells_every_token_the_grammar_has() {
        let shape, args = shape_of("SELECT a, b FROM t WHERE x <= 1 AND y >= 2 AND z != 3 AND w < 4 AND v > 5 AND u = 6")
        assert_eq(shape, "SELECT a, b FROM t WHERE x <= ? AND y >= ? AND z != ? AND w < ? AND v > ? AND u = ?")
        assert_eq(args.len(), 6)
        assert_eq(args[0].i, 1)
        assert_eq(args[5].i, 6)
        // Parens, star and comma survive; COUNT(*) is untouched.
        assert_eq(shape_of("SELECT COUNT(*) FROM t").0, "SELECT COUNT(*) FROM t")
        assert_eq(shape_of("INSERT INTO t VALUES (1, 'a'), (2, 'b')").0
            "INSERT INTO t VALUES (?, ?), (?, ?)")
        // A placeholder already written stays one and takes no argument.
        let q_shape, q_args = shape_of("SELECT v FROM t WHERE a = ?")
        assert_eq(q_shape, "SELECT v FROM t WHERE a = ?")
        assert_eq(q_args.len(), 0)
        // A trailing semicolon is part of the statement the parser sees.
        assert_eq(shape_of("SELECT v FROM t;").0, "SELECT v FROM t;")
    }

    #[test]
    fn normalize_reads_every_literal_the_lexer_reads() {
        let shape, args = shape_of("SELECT v FROM t WHERE a = 12 AND b = 3.5 AND c = -7 AND d = .5")
        assert_eq(shape, "SELECT v FROM t WHERE a = ? AND b = ? AND c = ? AND d = ?")
        assert_eq(args[0].tag, codec::TAG_I64)
        assert_eq(args[0].i, 12)
        assert_eq(args[1].tag, codec::TAG_F64)
        assert_eq(args[1].f, 3.5)
        assert_eq(args[2].i, -7)
        assert_eq(args[3].f, 0.5)
        // A minus that opens no literal is no token this grammar has, so the
        // scan hands the statement back and the parser says so - which is what
        // it would have said about the statement as written.
        let mut minus: Vec<codec::Value> = #[]
        assert_eq(super::normalize("SELECT v FROM t WHERE a = 1 - 2", &mut minus)
            "SELECT v FROM t WHERE a = 1 - 2")
        assert_eq(minus.len(), 0)
        assert(parser::parse("SELECT v FROM t WHERE a = 1 - 2").is_err())
        // A sign belongs to the literal wherever a value may open one.
        assert_eq(shape_of("INSERT INTO t VALUES (-1, -2.5)").1[1].f, -2.5)
        // TRUE, FALSE and NULL are words, so they stay in the shape.
        assert_eq(shape_of("SELECT v FROM t WHERE a = true AND b = NULL").0
            "SELECT v FROM t WHERE a = true AND b = NULL")
    }

    #[test]
    fn normalize_decodes_a_quoted_literal_the_way_the_lexer_does() {
        // A plain literal is its own text.
        assert_eq(shape_of("SELECT v FROM t WHERE a = 'plain'").1[0].s, "plain")
        // A doubled quote is one quote.
        assert_eq(shape_of("SELECT v FROM t WHERE a = 'it''s'").1[0].s, "it's")
        // Backslash escapes decode, including one before a quote, which does
        // not close the literal.
        assert_eq(shape_of("SELECT v FROM t WHERE a = 'a\\nb'").1[0].s, "a\nb")
        assert_eq(shape_of("SELECT v FROM t WHERE a = 'a\\tb'").1[0].s, "a\tb")
        assert_eq(shape_of("SELECT v FROM t WHERE a = 'a\\rb'").1[0].s, "a\rb")
        assert_eq(shape_of("SELECT v FROM t WHERE a = 'a\\'b'").1[0].s, "a'b")
        // Multi-byte content survives, escaped or not.
        assert_eq(shape_of("SELECT v FROM t WHERE a = 'héllo 🌍'").1[0].s, "héllo 🌍")
        assert_eq(shape_of("SELECT v FROM t WHERE a = 'x\\é'").1[0].s, "xé")
        // An empty literal is a literal.
        let e_shape, e_args = shape_of("SELECT v FROM t WHERE a = ''")
        assert_eq(e_shape, "SELECT v FROM t WHERE a = ?")
        assert_eq(e_args[0].s, "")
    }

    #[test]
    fn normalize_hands_back_what_it_cannot_shape() {
        // A literal with no closing quote, a byte the lexer has no token for,
        // and a number too wide to read: each comes back as it was written,
        // with nothing collected, so the parser reports it in its own words.
        for src in #[
            "SELECT v FROM t WHERE a = 'unterminated"
            "SELECT v FROM t WHERE a = 'esc\\"
            "SELECT v FROM t WHERE a © 1"
            "SELECT v FROM t WHERE a = 999999999999999999999999"
            "SELECT v FROM t WHERE a # 1"
        ] {
            let mut args: Vec<codec::Value> = #[]
            assert_eq(super::normalize(src, &mut args), src, src)
            assert_eq(args.len(), 0, src)
            // And what the parser says about the shape is what it says about
            // the statement, because they are the same text.
            assert(parser::parse(src).is_err(), src)
        }
    }

    #[test]
    fn normalize_treats_comments_and_spacing_as_one_separator() {
        let spelled = #[
            "SELECT   v\n\tFROM t   WHERE a = 1"
            "SELECT v FROM t -- why\n WHERE a = 1"
            "-- leading\nSELECT v FROM t WHERE a = 1"
            "SELECT v FROM t WHERE a = 1 -- trailing"
        ]
        let want = "SELECT v FROM t WHERE a = ?"
        for src in spelled {
            let shape, args = shape_of(src)
            assert_eq(shape.trim(), want, src)
            assert_eq(args.len(), 1, src)
        }
    }

    #[test]
    fn normalize_leaves_a_limit_count_where_the_grammar_wants_it() {
        let shape, args = shape_of("SELECT v FROM t WHERE a = 1 ORDER BY v LIMIT 10")
        assert_eq(shape, "SELECT v FROM t WHERE a = ? ORDER BY v LIMIT 10")
        assert_eq(args.len(), 1, "the LIMIT count is not an argument")
        // Case does not change that, and the count still ends the statement.
        assert_eq(shape_of("select v from t limit 3").0, "select v from t limit 3")
        // A number that merely follows the word BY is still an argument.
        assert_eq(shape_of("SELECT v FROM t WHERE by = 4").0, "SELECT v FROM t WHERE by = ?")
    }
}
