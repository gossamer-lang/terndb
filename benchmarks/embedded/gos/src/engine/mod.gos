use crate::sql
use crate::codec
use crate::kv

// terndb engine: the SQL statement layer over the KV store.
//
//   "schema/<table>"      the table definition
//   "<table>/r/<rowid>"   one row, its columns encoded back to back in
//                         schema order
//
// A schema record carries the table's own name, so reopening a directory
// rebuilds the catalogue from the values alone and never has to reparse a key.
//
// The parts: [`schema`] is a table's columns and the values that fit them,
// [`index`] the optional per-column index, [`filter`] a WHERE clause resolved
// against one table, [`bind`] the values a caller supplied for its `?`
// placeholders, [`scan`] the walk that answers it, [`stmt`] one statement
// carried out, [`plan`] a statement parsed and planned once, and [`cache`] the
// plans one caller keeps.

/// A table's name and its columns, in declaration order.
pub struct TableDef {
    pub name: String
    pub cols: Vec<String>
    pub tags: Vec<u8>
}

/// One row: its identity in the store and its column values.
pub struct Row {
    pub rowid: i64
    pub vals: Vec<codec::Value>
}

/// What a statement answered: the rows it produced, the column names they are
/// keyed by, and how many rows it affected.
pub struct QueryResult {
    pub cols: Vec<String>
    pub rows: Vec<Row>
    /// Rows written, updated or deleted, or matched by a `COUNT(*)`.
    pub count: i64
}

impl QueryResult {
    /// Renders the rows as one pipe-separated line each.
    pub fn render(&self) -> Vec<String> {
        let mut out: Vec<String> = #[]
        for row in self.rows { out.push(row.vals.join("|")) }
        out
    }
}

/// An open database: the KV store plus the table catalogue and rowid counters.
pub struct Engine {
    pub store: kv::Store
    pub tables: Map<String, TableDef>
    pub next_rowid: Map<String, i64>
    /// Indexed columns, in the order they were declared.
    pub indexes: Vec<index::ColIndex>
}

pub (package) fn row_prefix(table: String) -> String { table + "/r/" }

pub (package) fn schema_key(table: String) -> String { "schema/" + table }

/// Opens the database in `dir` and loads its table catalogue.
pub fn open(dir: String, read_only: bool = false) -> Result<Engine, String> {
    let mut eng = Engine { store: kv::open(dir, read_only)?, tables: Map::new(), next_rowid: Map::new(), indexes: #[] }
    for pair in kv::scan::pairs(&mut eng.store, "schema/")? {
        match schema::decode(pair.val) {
            Ok(def) => {
                // The row index is opened for every table the catalogue names,
                // so a table answers by id whether or not it holds a row yet.
                let tid = kv::rows::open_table(&mut eng.store, def.name)
                eng.next_rowid.insert(def.name, kv::rows::last_id(&mut eng.store, tid) + 1)
                eng.tables.insert(def.name, def)
            }
            Err(e) => return Err("open: " + pair.key + ": " + e)
        }
    }
    // An index is declared in the store and built from the rows: what is
    // written down is that the column is indexed, and the index itself is
    // whatever the table currently holds.
    for pair in kv::scan::pairs(&mut eng.store, "index/")? {
        let table, col = index::split_key(pair.key)
        if table == "" { return Err("open: " + pair.key + " is not an index declaration") }
        let mut def = get_def(&mut eng, table)?
        let ci = schema::col_index(&mut def, col)?
        index::attach(&mut eng, table, def.cols[ci], ci)?
    }
    Ok(eng)
}

/// The statements a caller runs, and what the engine says about itself.
impl Engine {
    /// Parses and runs one statement.
    ///
    /// The parse is the larger part of a small statement's cost, so a read served
    /// over and over should `prepare` it once and `run` it instead.
    pub fn exec(&mut self, src: String) -> Result<QueryResult, String> {
        self.exec_args(src, #[])
    }

    /// Parses and runs one statement with `args` filling its `?` placeholders, in
    /// the order they were written.
    ///
    /// A bound value is narrowed to its column's type the way a literal is, and the
    /// text it carries never reaches the parser: a value a caller did not write is
    /// the way to put one in a statement without building the statement around it.
    pub fn exec_args(&mut self, src: String, args: Vec<codec::Value>) -> Result<QueryResult, String> {
        match bind::stmt(sql::parser::parse(src)?, args)? {
            sql::Stmt::Create { name, cols, if_not_exists } => return stmt::create(self, name, cols, if_not_exists)
            sql::Stmt::CreateIndex { table, col, if_not_exists } => return stmt::create_index(self, table, col, if_not_exists)
            sql::Stmt::Drop { table, if_exists } => return stmt::drop_table(self, table, if_exists)
            sql::Stmt::DropIndex { table, col, if_exists } => return stmt::drop_index(self, table, col, if_exists)
            sql::Stmt::Insert { table, cols, rows } => return stmt::insert(self, table, cols, rows)
            sql::Stmt::Select(q) => return stmt::select(self, q)
            sql::Stmt::Update { table, sets, conds } => return stmt::update(self, table, sets, conds)
            sql::Stmt::Delete { table, conds } => return stmt::delete(self, table, conds)
            sql::Stmt::Compact => {
                read_only_refuses(self)?
                kv::compact::run(&mut self.store)?
                return Ok(empty_result())
            }
        }
    }

    /// What the open read past in the log, one line each, empty for a clean store.
    ///
    /// A store recovers to its last good commit and opens, so this is what a caller
    /// says out loud rather than serving a log that quietly ends early.
    pub fn faults(&self) -> Vec<String> { self.store.faults }

    /// The table names in the catalogue, in order.
    pub fn table_names(&self) -> Vec<String> {
        let mut names: Vec<String> = #[]
        for name in self.tables.keys() { names.push(name) }
        names.sort()
        names
    }

    /// Makes every completed write durable.
    pub fn sync(&mut self) -> Result<(), String> { self.store.sync() }

    /// Sets whether a statement is flushed to the platter before it reports success.
    ///
    /// Durable is the default and is what makes a committed statement survive a
    /// power loss. Turning it off keeps every other guarantee - a statement is
    /// still all-or-nothing, and a crash still leaves the store consistent - but a
    /// commit may be lost if the machine stops before the operating system writes
    /// it out. It is for bulk loading, not for serving.
    pub fn set_durable(&mut self, durable: bool) { self.store.durable = durable }
}

pub (package) fn empty_result() -> QueryResult { QueryResult { cols: #[], rows: #[], count: 0 } }

// A result carrying nothing but the number of rows a write touched.
pub (package) fn affected(n: i64) -> Result<QueryResult, String> {
    Ok(QueryResult { cols: #[], rows: #[], count: n })
}

// A result carrying one count, which is what COUNT(*) answers with.
pub (package) fn counted(n: i64) -> Result<QueryResult, String> {
    Ok(QueryResult { cols: #["count"], rows: #[Row { rowid: 0, vals: #[codec::Value::int(n)] }], count: n })
}

// The rows a LIMIT and an OFFSET leave, given the matches in the order they
// were produced.
pub (package) fn window(rows: Vec<Row>, offset: i64, limit: i64) -> Vec<Row> {
    if offset == 0 && limit < 0 { return rows }
    if offset >= rows.len() { return #[] }
    let mut end = rows.len()
    if limit >= 0 && offset + limit < end { end = offset + limit }
    let mut out: Vec<Row> = #[]
    let mut i = offset
    while i < end {
        out.push(rows[i])
        i += 1
    }
    out
}

// How many of `matched` rows a LIMIT and an OFFSET leave, which is what a
// COUNT(*) carrying either answers.
pub (package) fn window_count(matched: i64, offset: i64, limit: i64) -> i64 {
    let rest = if matched > offset { matched - offset } else { 0 }
    if limit >= 0 && rest > limit { limit } else { rest }
}

// The catalogue is reached through the engine rather than a copy of it: an
// engine holds the store's whole index, so a by-value read would copy every
// key on the way to one table definition.
pub (package) fn get_def(eng: &mut Engine, table: String) -> Result<TableDef, String> {
    match eng.tables.get(table) {
        Some(d) => Ok(d)
        None => Err("no such table: " + table)
    }
}

// A statement that would write is refused before it reaches anything mutable.
// A read-only engine is what several readers share, so a write that got as far
// as the catalogue would be one reader writing to another's store.
pub (package) fn read_only_refuses(eng: &mut Engine) -> Result<(), String> {
    if eng.store.read_only { return Err("store is read-only") }
    Ok(())
}

#[cfg(test)]
mod tests {
    use std::fs
    use crate::codec

    fn fresh(name: String) -> String {
        let dir = "/tmp/terndb_engine_test/" + name
        let _ = fs::remove_dir_all(dir)
        let _ = fs::create_dir_all(dir)
        dir
    }

    fn opened(dir: String) -> super::Engine {
        super::open(dir, false).unwrap_or_else(|e| panic("open " + dir + ": " + e))
    }

    fn run(eng: &mut super::Engine, src: String) -> i64 {
        match eng.exec(src) {
            Ok(res) => return res.count
            Err(e) => {
                assert(false, src + " -> " + e)
                return -1
            }
        }
    }

    fn rows(eng: &mut super::Engine, src: String) -> Vec<Vec<String>> {
        match eng.exec(src) {
            Ok(res) => {
                let mut out: Vec<Vec<String>> = #[]
                for row in res.rows {
                    let mut cells: Vec<String> = #[]
                    for v in row.vals { cells.push(v.to_string()) }
                    out.push(cells)
                }
                return out
            }
            Err(e) => {
                assert(false, src + " -> " + e)
                return #[]
            }
        }
    }

    fn users(eng: &mut super::Engine) {
        assert_eq(run(eng, "CREATE TABLE users (name TEXT, age INT32, active BOOL, at DATETIME, score FLOAT)"), 0)
        assert_eq(run(eng, "INSERT INTO users VALUES ('alice', 30, true, '2023-11-14T22:13:20Z', 1.5)"), 1)
        assert_eq(run(eng, "INSERT INTO users VALUES ('bob', 40, false, '2023-12-01T10:00:00Z', 2.5)"), 1)
        assert_eq(run(eng, "INSERT INTO users VALUES ('carol', 25, true, '2024-01-01T00:00:00Z', 3.5)"), 1)
    }

    #[test]
    fn query_returns_rows_without_the_count() {
        let mut eng = opened(fresh("query"))
        users(&mut eng)
        match eng.exec("SELECT name FROM users ORDER BY name LIMIT 1") {
            Ok(res) => { let mut r = res; assert_eq(r.render(), #["alice"]) }
            Err(e) => assert(false, e)
        }
    }

    #[test]
    fn render_joins_a_row_with_pipes() {
        let mut eng = opened(fresh("render"))
        users(&mut eng)
        match eng.exec("SELECT name, age FROM users ORDER BY age") {
            Ok(mut res) => {
                assert_eq(res.render(), #["carol|25", "alice|30", "bob|40"])
                assert_eq(res.cols, #["name", "age"])
            }
            Err(e) => assert(false, e)
        }
        let none = super::QueryResult { cols: #[], rows: #[], count: 0 }
        assert_eq(none.render(), #[])
    }

    #[test]
    fn the_catalogue_and_the_data_survive_a_restart() {
        let dir = fresh("restart")
        let mut eng = opened(dir)
        users(&mut eng)
        assert_eq(run(&mut eng, "DELETE FROM users WHERE name = 'alice'"), 1)
        assert(eng.sync().is_ok())

        let mut again = opened(dir)
        assert_eq(again.table_names(), #["users"], "the schema is read back from the store")
        assert_eq(run(&mut again, "SELECT * FROM users"), 2)
        assert_eq(rows(&mut again, "SELECT name, age FROM users ORDER BY age"), #[#["carol", "25"], #["bob", "40"]])
        assert_eq(run(&mut again, "INSERT INTO users VALUES ('dave', 50, true, '2024-02-02T00:00:00Z', 4.5)"), 1)
        assert_eq(run(&mut again, "SELECT * FROM users"), 3)
        assert_eq(rows(&mut again, "SELECT name FROM users ORDER BY age DESC LIMIT 1"), #[#["dave"]])
    }

    #[test]
    fn several_tables_stay_independent() {
        let dir = fresh("multi_table")
        let mut eng = opened(dir)
        assert_eq(run(&mut eng, "CREATE TABLE a (v TEXT)"), 0)
        assert_eq(run(&mut eng, "CREATE TABLE b (v INT32)"), 0)
        assert_eq(run(&mut eng, "INSERT INTO a VALUES ('x'), ('y')"), 2)
        assert_eq(run(&mut eng, "INSERT INTO b VALUES (1)"), 1)
        assert_eq(run(&mut eng, "SELECT * FROM a"), 2)
        assert_eq(run(&mut eng, "SELECT * FROM b"), 1)
        assert_eq(run(&mut eng, "DELETE FROM a"), 2)
        assert_eq(run(&mut eng, "SELECT * FROM b"), 1, "emptying one table leaves the other alone")
        assert_eq(eng.table_names(), #["a", "b"])

        let mut again = opened(dir)
        assert_eq(again.table_names(), #["a", "b"])
        assert_eq(run(&mut again, "SELECT * FROM b"), 1)
    }

    #[test]
    fn compaction_preserves_every_table() {
        let dir = fresh("compact")
        let mut eng = opened(dir)
        users(&mut eng)
        assert_eq(run(&mut eng, "CREATE TABLE other (v TEXT)"), 0)
        assert_eq(run(&mut eng, "INSERT INTO other VALUES ('keep')"), 1)
        assert_eq(run(&mut eng, "DELETE FROM users WHERE name = 'alice'"), 1)
        assert_eq(run(&mut eng, "UPDATE users SET score = 8.5 WHERE name = 'bob'"), 1)
        assert_eq(run(&mut eng, "COMPACT"), 0)

        assert_eq(run(&mut eng, "SELECT * FROM users"), 2)
        assert_eq(rows(&mut eng, "SELECT score FROM users WHERE name = 'bob'"), #[#["8.5"]])
        assert_eq(rows(&mut eng, "SELECT v FROM other"), #[#["keep"]])
        assert_eq(run(&mut eng, "INSERT INTO users VALUES ('erin', 60, true, '2024-03-03T00:00:00Z', 5.5)"), 1)

        let mut again = opened(dir)
        assert_eq(again.table_names(), #["other", "users"])
        assert_eq(run(&mut again, "SELECT * FROM users"), 3)
        assert_eq(rows(&mut again, "SELECT score FROM users WHERE name = 'bob'"), #[#["8.5"]])
        assert_eq(rows(&mut again, "SELECT v FROM other"), #[#["keep"]])
    }

    #[test]
    fn statements_against_a_missing_table_are_rejected() {
        let mut eng = opened(fresh("missing_table"))
        assert(eng.exec("SELECT * FROM nope").is_err())
        assert(eng.exec("INSERT INTO nope VALUES (1)").is_err())
        assert(eng.exec("UPDATE nope SET a = 1").is_err())
        assert(eng.exec("DELETE FROM nope").is_err())
        assert_eq(run(&mut eng, "CREATE TABLE t (a INT32)"), 0)
        assert(eng.exec("CREATE TABLE t (a INT32)").is_err(), "a table is created once")
    }

    #[test]
    fn a_read_only_database_answers_queries_and_refuses_writes() {
        let dir = fresh("read_only")
        let mut writer = opened(dir)
        users(&mut writer)
        assert(writer.sync().is_ok())

        match super::open(dir, true) {
            Ok(reader) => {
                let mut r = reader
                assert_eq(run(&mut r, "SELECT * FROM users"), 3)
                assert_eq(rows(&mut r, "SELECT COUNT(*) FROM users WHERE age > 26"), #[#["2"]])
                assert(r.exec("INSERT INTO users VALUES ('x', 1, true, 0, 1)").is_err())
                assert(r.exec("DELETE FROM users").is_err())
                assert(r.exec("COMPACT").is_err())
            }
            Err(e) => assert(false, e)
        }
    }

    #[test]
    fn many_rows_survive_a_write_compact_restart_cycle() {
        let dir = fresh("bulk")
        let mut eng = opened(dir)
        assert_eq(run(&mut eng, "CREATE TABLE t (id INT32, name TEXT)"), 0)
        let mut i: i64 = 0
        while i < 200 {
            assert_eq(run(&mut eng, "INSERT INTO t VALUES (" + i.to_string() + ", 'row-" + i.to_string() + "')"), 1)
            i += 1
        }
        assert_eq(run(&mut eng, "DELETE FROM t WHERE id < 50"), 50)
        assert_eq(run(&mut eng, "UPDATE t SET name = 'updated' WHERE id = 100"), 1)
        assert_eq(run(&mut eng, "COMPACT"), 0)
        assert(eng.sync().is_ok())

        let mut again = opened(dir)
        assert_eq(rows(&mut again, "SELECT COUNT(*) FROM t"), #[#["150"]])
        assert_eq(rows(&mut again, "SELECT name FROM t WHERE id = 100"), #[#["updated"]])
        assert_eq(rows(&mut again, "SELECT name FROM t ORDER BY id LIMIT 1"), #[#["row-50"]])
        assert_eq(rows(&mut again, "SELECT name FROM t ORDER BY id DESC LIMIT 1"), #[#["row-199"]])
    }

    #[test]
    fn a_guarded_create_runs_twice_as_it_runs_once() {
        let mut eng = opened(fresh("guarded_create"))
        assert_eq(run(&mut eng, "CREATE TABLE IF NOT EXISTS t (a INT32)"), 0)
        assert_eq(run(&mut eng, "CREATE TABLE IF NOT EXISTS t (a INT32)"), 0)
        assert_eq(run(&mut eng, "INSERT INTO t VALUES (1)"), 1)
        // The guard leaves the table it found, rows and all.
        assert_eq(run(&mut eng, "CREATE TABLE IF NOT EXISTS t (b TEXT)"), 0)
        assert_eq(rows(&mut eng, "SELECT a FROM t"), #[#["1"]])
        assert(eng.exec("CREATE TABLE t (a INT32)").is_err(), "an unguarded second create is refused")

        assert_eq(run(&mut eng, "CREATE INDEX IF NOT EXISTS ON t (a)"), 0)
        assert_eq(run(&mut eng, "CREATE INDEX IF NOT EXISTS ON t (a)"), 0)
        assert(eng.exec("CREATE INDEX ON t (a)").is_err(), "an unguarded second index is refused")
    }

    #[test]
    fn dropping_a_table_takes_its_rows_and_its_indexes_with_it() {
        let dir = fresh("drop_table")
        let mut eng = opened(dir)
        assert_eq(run(&mut eng, "CREATE TABLE t (a INT32, b TEXT)"), 0)
        assert_eq(run(&mut eng, "CREATE INDEX ON t (a)"), 0)
        assert_eq(run(&mut eng, "INSERT INTO t VALUES (1, 'x'), (2, 'y')"), 2)
        assert_eq(run(&mut eng, "CREATE TABLE keep (v TEXT)"), 0)
        assert_eq(run(&mut eng, "INSERT INTO keep VALUES ('here')"), 1)

        assert_eq(run(&mut eng, "DROP TABLE t"), 2, "the count is the rows the table held")
        assert_eq(eng.table_names(), #["keep"])
        assert(eng.exec("SELECT * FROM t").is_err(), "the table is gone from the catalogue")
        assert(eng.sync().is_ok())

        // Nothing on disk names the table, so a reopen does not bring it back.
        let mut again = opened(dir)
        assert_eq(again.table_names(), #["keep"])
        assert_eq(rows(&mut again, "SELECT v FROM keep"), #[#["here"]])

        // The name is free again, and the new table starts empty.
        assert_eq(run(&mut again, "CREATE TABLE t (a INT32, b TEXT)"), 0)
        assert_eq(rows(&mut again, "SELECT COUNT(*) FROM t"), #[#["0"]])
    }

    #[test]
    fn a_guarded_drop_answers_for_a_table_that_is_not_there() {
        let mut eng = opened(fresh("guarded_drop"))
        assert_eq(run(&mut eng, "DROP TABLE IF EXISTS nope"), 0)
        assert(eng.exec("DROP TABLE nope").is_err(), "an unguarded drop names what it cannot find")
        assert_eq(run(&mut eng, "CREATE TABLE t (a INT32)"), 0)
        assert_eq(run(&mut eng, "DROP INDEX IF EXISTS ON t (a)"), 0)
        assert(eng.exec("DROP INDEX ON t (a)").is_err(), "an unguarded drop of no index is refused")
    }

    #[test]
    fn dropping_an_index_leaves_the_rows_and_the_answers() {
        let dir = fresh("drop_index")
        let mut eng = opened(dir)
        assert_eq(run(&mut eng, "CREATE TABLE t (a INT32, v TEXT)"), 0)
        assert_eq(run(&mut eng, "CREATE INDEX ON t (a)"), 0)
        assert_eq(run(&mut eng, "INSERT INTO t VALUES (1, 'x'), (2, 'y'), (1, 'z')"), 3)
        let indexed = rows(&mut eng, "SELECT v FROM t WHERE a = 1 ORDER BY v")

        assert_eq(run(&mut eng, "DROP INDEX ON t (a)"), 0)
        assert_eq(rows(&mut eng, "SELECT v FROM t WHERE a = 1 ORDER BY v"), indexed)
        assert(eng.sync().is_ok())

        let mut again = opened(dir)
        assert_eq(rows(&mut again, "SELECT v FROM t WHERE a = 1 ORDER BY v"), indexed)
        // The declaration is gone from the store, so the column may be indexed again.
        assert_eq(run(&mut again, "CREATE INDEX ON t (a)"), 0)
    }

    #[test]
    fn an_insert_naming_its_columns_leaves_the_rest_null() {
        let mut eng = opened(fresh("insert_columns"))
        assert_eq(run(&mut eng, "CREATE TABLE t (a INT32, b TEXT, c BOOL)"), 0)
        assert_eq(run(&mut eng, "INSERT INTO t (b, a) VALUES ('x', 1)"), 1)
        assert_eq(rows(&mut eng, "SELECT a, b, c FROM t"), #[#["1", "x", "NULL"]])
        assert_eq(run(&mut eng, "INSERT INTO t (b) VALUES ('y'), ('z')"), 2)
        assert_eq(rows(&mut eng, "SELECT b FROM t ORDER BY b"), #[#["x"], #["y"], #["z"]])
        assert(eng.exec("INSERT INTO t (a) VALUES (1, 2)").is_err(), "the row must match the columns named")
        assert(eng.exec("INSERT INTO t (nope) VALUES (1)").is_err(), "an unknown column is refused")
        assert(eng.exec("INSERT INTO t (a) VALUES ('text')").is_err(), "a named column still checks its type")
    }

    #[test]
    fn offset_skips_the_rows_before_the_limit() {
        let mut eng = opened(fresh("offset"))
        assert_eq(run(&mut eng, "CREATE TABLE t (a INT32)"), 0)
        assert_eq(run(&mut eng, "INSERT INTO t VALUES (1), (2), (3), (4), (5)"), 5)
        assert_eq(rows(&mut eng, "SELECT a FROM t ORDER BY a LIMIT 2 OFFSET 1"), #[#["2"], #["3"]])
        assert_eq(rows(&mut eng, "SELECT a FROM t ORDER BY a OFFSET 3"), #[#["4"], #["5"]])
        assert_eq(rows(&mut eng, "SELECT a FROM t ORDER BY a LIMIT 2 OFFSET 9"), #[])
        assert_eq(rows(&mut eng, "SELECT COUNT(*) FROM t LIMIT 2 OFFSET 1"), #[#["2"]])
        assert_eq(rows(&mut eng, "SELECT COUNT(*) FROM t OFFSET 4"), #[#["1"]])
        // An unordered walk stops once the window is filled, and skips the same rows.
        assert_eq(rows(&mut eng, "SELECT a FROM t LIMIT 2 OFFSET 2"), #[#["3"], #["4"]])
        // A rowid the statement names is one read, which no offset can reach past.
        assert_eq(rows(&mut eng, "SELECT a FROM t WHERE rowid = 2 OFFSET 1"), #[])
    }

    #[test]
    fn not_equal_answers_the_same_in_either_spelling() {
        let mut eng = opened(fresh("not_equal"))
        assert_eq(run(&mut eng, "CREATE TABLE t (a INT32)"), 0)
        assert_eq(run(&mut eng, "INSERT INTO t VALUES (1), (2), (3)"), 3)
        let bang = rows(&mut eng, "SELECT a FROM t WHERE a != 2 ORDER BY a")
        assert_eq(bang, #[#["1"], #["3"]])
        assert_eq(rows(&mut eng, "SELECT a FROM t WHERE a <> 2 ORDER BY a"), bang)
    }
}
