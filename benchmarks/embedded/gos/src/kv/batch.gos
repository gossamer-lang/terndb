use crate::kv
use super::log
use super::rows

// Batches: a group of records the log makes visible together.
//
// A batch stages its index changes and appends a commit record; the changes
// land only once that record is durable. A write outside an explicit batch is a
// batch of one, so every write is atomic whether or not the caller asked for a
// transaction.

// One staged change, held until its batch commits.
pub (package) struct Staged {
    pub (package) key: String
    pub (package) entry: kv::Entry
    pub (package) remove: bool
    /// The table and row the key addresses, or -1 for a key nobody placed.
    pub (package) tid: i64
    pub (package) rid: i64
    /// The key's checksum, carried so placing the row recomputes nothing.
    pub (package) kcrc: i64
}

/// Opens a batch: nothing written inside it is visible until it commits.
pub fn begin(st: &mut kv::Store) -> Result<(), String> {
    if st.read_only { return Err("store is read-only") }
    if st.in_batch { return Err("a batch is already open") }
    st.in_batch = true
    st.batch_start = st.cur_off
    st.pending_at = st.cur_off
    st.pending.clear()
    st.touched = false
    st.staged.clear()
    Ok(())
}

/// Commits the open batch, making it durable and visible in that order.
pub fn commit(st: &mut kv::Store) -> Result<(), String> {
    if !st.in_batch { return Err("no batch is open") }
    // The commit record is what a rebuild looks for, so it is written before
    // the flush and the index is only touched once both have succeeded. A
    // commit that cannot be made durable is rewound here: leaving the batch
    // open would refuse every statement after it for the life of the store.
    if let Err(e) = kv::stage(st, "", log::KIND_COMMIT, #[], log::record_crc("", #[])) {
        return Err(undo(st, e))
    }
    if let Err(e) = kv::flush_pending(st) { return Err(undo(st, e)) }
    if st.durable {
        if let Err(e) = st.sync() { return Err(undo(st, e)) }
    }
    for change in st.staged {
        if change.remove {
            rows::forget(st, change.key)
        } else if change.tid >= 0 {
            rows::remember_row(st, change.tid, change.rid, change.kcrc, change.entry)
        } else {
            rows::remember(st, change.key, change.entry)
        }
    }
    st.staged.clear()
    st.in_batch = false
    // The merge happens here rather than inside the batch, so it only ever sees
    // a log every record of which is accounted for. It is housekeeping over a
    // commit that has already landed, so a merge that fails is recorded and
    // stood down from rather than reported as the statement failing, which
    // would have a caller write again what is already on the platter.
    if compact::due(st) {
        if let Err(e) = compact::compact_dirty(st) {
            st.faults.push("automatic merge: " + e +
                "; merging is left to the caller until the store is opened again")
            compact::set_ratio(st, 0.0)
        }
    }
    Ok(())
}

/// Discards the open batch, rewinding the log over whatever it wrote.
pub fn rollback(st: &mut kv::Store) -> Result<(), String> {
    if !st.in_batch { return Err("no batch is open") }
    st.cur_off = st.batch_start
    st.staged.clear()
    st.pending.clear()
    st.in_batch = false
    // Bytes the batch never wrote need no rewind; bytes it wrote early, or a
    // write that failed part-way, are cut back so the file ends where the store
    // says it does.
    st.pending_at = st.batch_start
    if !st.touched { return Ok(()) }
    st.touched = false
    match st.data {
        Some(f) => {
            match f.set_len(st.batch_start) {
                Ok(_) => Ok(())
                Err(e) => Err("rollback: " + e.message())
            }
        }
        None => Ok(())
    }
}

/// Rewinds the open batch and answers what to report for `e`, the failure that
/// asked for the rewind.
///
/// A rewind that did not happen leaves the log holding bytes the store's own
/// offset says are free, so it is named beside the failure that led to it
/// rather than passed over for it.
pub fn undo(st: &mut kv::Store, e: String) -> String {
    match rollback(st) {
        Ok(()) => e
        Err(re) => e + "; " + re
    }
}

// A write outside an explicit batch is a batch of one, so every write is
// atomic and durable whether or not the caller asked for a transaction.
pub (package) fn solo(st: &mut kv::Store) -> bool { !st.in_batch }

// A key written earlier in this batch is present for the batch's own purposes,
// even though the index will not show it until the batch commits.
pub (package) fn staged_holds(st: &mut kv::Store, key: String) -> bool {
    for change in st.staged {
        if change.key == key { return !change.remove }
    }
    false
}

#[cfg(test)]
mod tests {
    use std::fs
    use crate::kv

    fn fresh(name: String) -> String {
        let dir = "/tmp/terndb_kv_test/" + name
        let _ = fs::remove_dir_all(dir)
        let _ = fs::create_dir_all(dir)
        dir
    }

    fn opened(dir: String) -> kv::Store {
        kv::open(dir).unwrap_or_else(|e| panic("open " + dir + ": " + e))
    }

    fn must_get(st: &mut kv::Store, key: String) -> Vec<u8> {
        match st.get(key) {
            kv::Read::Value(v) => return v
            kv::Read::Fault(e) => panic(e)
            kv::Read::Absent => {
                assert(false, "expected a value for '" + key + "'")
                return #[]
            }
        }
    }

    #[test]
    fn a_batch_is_invisible_until_it_commits() {
        let dir = fresh("batch_visibility")
        let mut st = opened(dir)
        assert(st.put("before", #[1u8]).is_ok())
        assert(super::begin(&mut st).is_ok())
        assert(st.put("inside", #[2u8]).is_ok())
        assert(matches(st.get("inside"), kv::Read::Absent), "an uncommitted write is not readable")
        assert_eq(st.len(), 1, "an uncommitted write is not counted")
        assert(super::commit(&mut st).is_ok())
        assert_eq(must_get(&mut st, "inside"), #[2u8])
        assert_eq(st.len(), 2)
    }

    #[test]
    fn a_rolled_back_batch_leaves_the_store_as_it_was() {
        let dir = fresh("batch_rollback")
        let mut st = opened(dir)
        assert(st.put("keep", #[1u8]).is_ok())
        let mark = st.cur_off
        assert(super::begin(&mut st).is_ok())
        assert(st.put("a", #[2u8]).is_ok())
        assert(st.put("b", #[3u8]).is_ok())
        assert(st.put("keep", #[9u8]).is_ok())
        assert(super::rollback(&mut st).is_ok())
        assert_eq(st.len(), 1)
        assert(matches(st.get("a"), kv::Read::Absent))
        assert_eq(must_get(&mut st, "keep"), #[1u8], "the overwrite was rolled back too")
        assert_eq(st.cur_off, mark, "the log rewound over the batch")

        assert(st.put("after", #[4u8]).is_ok())
        let mut again = opened(dir)
        assert_eq(again.len(), 2)
        assert_eq(must_get(&mut again, "keep"), #[1u8])
        assert_eq(must_get(&mut again, "after"), #[4u8])
    }

    #[test]
    fn a_batch_that_never_commits_is_not_replayed() {
        let dir = fresh("batch_uncommitted")
        let mut st = opened(dir)
        assert(st.put("committed", #[1u8]).is_ok())
        assert(super::begin(&mut st).is_ok())
        assert(st.put("orphan1", #[2u8]).is_ok())
        assert(st.put("orphan2", #[3u8]).is_ok())
        assert(st.sync().is_ok())
        // The process stops here: the records are on disk, the commit is not.
        let committed_end = st.batch_start

        let mut after = opened(dir)
        assert_eq(after.len(), 1, "an uncommitted batch is not replayed")
        assert(matches(after.get("orphan1"), kv::Read::Absent))
        assert(matches(after.get("orphan2"), kv::Read::Absent))
        assert_eq(must_get(&mut after, "committed"), #[1u8])
        assert_eq(after.cur_off, committed_end, "the next append reuses the orphaned bytes")
        assert(after.put("next", #[4u8]).is_ok())
        assert_eq(must_get(&mut after, "next"), #[4u8])
        assert_eq(must_get(&mut after, "committed"), #[1u8])
    }

    #[test]
    fn a_batch_deletes_and_writes_together() {
        let dir = fresh("batch_mixed")
        let mut st = opened(dir)
        assert(st.put("old", #[1u8]).is_ok())
        assert(super::begin(&mut st).is_ok())
        assert_eq(st.delete("old").unwrap_or(false), true)
        assert(st.put("new", #[2u8]).is_ok())
        assert_eq(must_get(&mut st, "old"), #[1u8], "the delete is not visible yet")
        assert(super::commit(&mut st).is_ok())
        assert(matches(st.get("old"), kv::Read::Absent))
        assert_eq(must_get(&mut st, "new"), #[2u8])

        let mut after = opened(dir)
        assert(matches(after.get("old"), kv::Read::Absent))
        assert_eq(must_get(&mut after, "new"), #[2u8])
    }

    // Enough rows to pass the size at which a batch writes what it has so far.
    fn fill_past_flush(st: &mut kv::Store, tid: i64) {
        for rid in 1..40 {
            assert(kv::rows::write(st, tid, rid, #[7u8; 40_000]).is_ok())
        }
    }

    #[test]
    fn a_large_batch_rolled_back_leaves_the_file_where_it_was() {
        let dir = fresh("batch_large_rollback")
        let mut st = opened(dir)
        assert(st.put("keep", #[1u8]).is_ok())
        let mark = st.cur_off
        let tid = kv::rows::open_table(&mut st, "t")
        assert(super::begin(&mut st).is_ok())
        fill_past_flush(&mut st, tid)
        assert(fs::file_size(kv::log::data_path(dir, st.gen)) > mark, "part of the batch was written early")
        assert(super::rollback(&mut st).is_ok())
        assert_eq(fs::file_size(kv::log::data_path(dir, st.gen)), mark)
        assert_eq(st.len(), 1)
        let mut again = opened(dir)
        assert_eq(again.len(), 1)
        assert_eq(must_get(&mut again, "keep"), #[1u8])
    }

    #[test]
    fn a_large_batch_that_never_commits_is_not_replayed() {
        let dir = fresh("batch_large_uncommitted")
        let mut st = opened(dir)
        assert(st.put("keep", #[1u8]).is_ok())
        let tid = kv::rows::open_table(&mut st, "t")
        assert(super::begin(&mut st).is_ok())
        fill_past_flush(&mut st, tid)
        assert(st.sync().is_ok())
        // The process stops here, with part of the batch on disk.
        let mut after = opened(dir)
        assert_eq(after.len(), 1, "no row of the batch is replayed")
        assert_eq(after.faults.len(), 0, "an unfinished batch is not a fault")
        // A write shorter than the abandoned batch leaves its tail behind it,
        // which the next open must not read as a damaged record.
        assert(after.put("next", #[2u8]).is_ok())
        let mut again = opened(dir)
        assert_eq(again.len(), 2)
        assert_eq(again.faults, #[])
        assert_eq(must_get(&mut again, "next"), #[2u8])
    }

    #[test]
    fn what_an_abandoned_batch_leaves_behind_is_never_read_as_a_record() {
        let dir = fresh("batch_abandoned_tail")
        let mut st = opened(dir)
        assert(st.put("keep", #[1u8]).is_ok())
        // The abandoned value carries, eight bytes in, what reads as a whole
        // record header whose checksum is wrong: crc 0x09090909, a put, a
        // one-byte key and a one-byte value.
        let mut val: Vec<u8> = #[0u8; 8]
        val.extend(#[9u8, 9, 9, 9, 0, 1, 0, 1, 0, 0, 0, 65, 66])
        assert(super::begin(&mut st).is_ok())
        assert(st.put("abandon", val).is_ok())
        assert(kv::flush_pending(&mut st).is_ok())
        assert(st.sync().is_ok())
        // The process stops. The next write - an 11-byte header, a one-byte key
        // and a three-byte value, then an 11-byte commit - ends exactly where
        // that header begins.
        let mut after = opened(dir)
        assert(after.put("n", #[1u8, 2, 3]).is_ok())
        let mut again = opened(dir)
        assert_eq(again.faults, #[], "an abandoned batch is not a damaged log")
        assert_eq(again.len(), 2)
        assert_eq(must_get(&mut again, "n"), #[1u8, 2, 3])
    }

    #[test]
    fn a_commit_that_cannot_be_written_leaves_nothing_visible() {
        let dir = fresh("batch_write_fails")
        let mut st = opened(dir)
        assert(st.put("keep", #[1u8]).is_ok())
        let writable = st.data
        // A handle opened for reading refuses the batch's one write.
        st.data = kv::log::open_read(kv::log::data_path(dir, st.gen))
        assert(st.put("lost", #[2u8]).is_err())
        assert(matches(st.get("lost"), kv::Read::Absent))
        st.data = writable
        assert(st.put("after", #[3u8]).is_ok(), "the store takes writes again")
        let mut again = opened(dir)
        assert_eq(again.len(), 2)
        assert(matches(again.get("lost"), kv::Read::Absent))
        assert_eq(must_get(&mut again, "after"), #[3u8])
    }

    #[test]
    fn batch_bookkeeping_rejects_a_misuse() {
        let mut st = opened(fresh("batch_misuse"))
        assert(super::commit(&mut st).is_err(), "there is no batch to commit")
        assert(super::rollback(&mut st).is_err(), "there is no batch to roll back")
        assert(super::begin(&mut st).is_ok())
        assert(super::begin(&mut st).is_err(), "batches do not nest")
        assert(super::commit(&mut st).is_ok())
    }
}
