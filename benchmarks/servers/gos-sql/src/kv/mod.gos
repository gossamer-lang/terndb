use std::fs

// terndb KV engine: a Bitcask-style append-only log with an in-memory index.
//
//   data record:  [crc u32 LE][kind u8][klen u16 LE][vlen u32 LE][key][value]
//   hint record:  [klen u16 LE][vlen u32 LE][crc u32 LE][offset u64 LE][key]
//
// Files are named `<gen>.data`, with `<gen>.hint` beside a generation that
// compaction has merged. A generation carrying a hint file is sealed: nothing
// is ever appended to it again, so the hint stays an exact description of the
// data file and a restart can rebuild that generation's index without reading
// a single value byte. Writes go to the one unsealed generation.
//
// A read is one index lookup plus one positional read of the value. The record's
// checksum is carried in the index rather than re-read from its header, so a get
// touches the file exactly once and still verifies what it returns.
//
// Writes are transactional. A batch appends its records and then a commit
// record, and only a committed batch is ever visible: the index is updated when
// the commit lands, and a rebuild applies records only as far as the last commit
// it saw. A batch interrupted by a crash is therefore invisible and its bytes
// are overwritten by the next append, which is what makes a multi-row statement
// all-or-nothing.
//
// The parts: [`log`] frames a record and names the files, [`index`] is what the
// store holds in memory, [`batch`] makes a group of records visible at once,
// [`recover`] rebuilds the index at open, [`scan`] answers a key prefix, and
// [`compact`] merges the log.

const MAX_KEY_LEN: i64 = 65_535

pub (package) const MAX_VALUE_LEN: i64 = 1_048_576

/// What a read answers: the value, the absence of one, or why neither.
///
/// The three are distinct because a store that cannot produce a record it holds
/// has not answered "not there" - and a caller told that would carry on as
/// though the store were whole. The arms are spelled out rather than nested in
/// an `Option` inside a `Result`, which is one value per read on the hottest
/// path there is.
pub enum Read {
    Value(Vec<u8>)
    /// The store does not hold this key: it was never written, or it was
    /// deleted.
    Absent
    /// The store holds it and cannot produce it, and this says why.
    Fault(String)
}

/// Where a live key's record sits, and the checksum that record was written with.
pub struct Entry {
    pub file: i64
    pub offset: i64
    pub vlen: i64
    pub crc: i64
}

/// A key and its value, as returned by a prefix scan.
pub struct KvPair {
    pub key: String
    pub val: Vec<u8>
}

/// An open store: the index, the active append file, and the space accounting.
pub struct Store {
    pub dir: String
    pub gen: i64
    pub index: Map<String, Entry>
    pub data: Option<fs::File>
    pub cur_off: i64
    pub read_only: bool
    pub live_bytes: i64
    pub dead_bytes: i64
    // Sealed generations are immutable, so one handle per generation serves
    // every read of it and a get costs no open.
    pub readers: Map<i64, fs::File>
    /// Tables whose rows are held by rowid; every other key is in `index`.
    ///
    /// A keyed read is three loads out of this and one positional read of the
    /// file, and writes nothing back, so a read-only store is untouched while it
    /// answers.
    pub tables: Vec<rows::RowIndex>
    /// Whether a commit is flushed to the platter before it is reported done.
    pub durable: bool
    /// Fraction of the log that may be superseded before a commit merges it,
    /// or 0 to leave merging to the caller.
    pub auto_compact: f64
    /// The sealed generation whose bytes the store holds, or 0 for none.
    ///
    /// A sealed generation carries a hint file and is never appended to
    /// again, so nothing can make the held bytes wrong and nothing has to
    /// invalidate them. One generation is held rather than a map of them: a
    /// compacted store has one, and the bytes are reached as a field so a
    /// read is a look at them rather than a copy out of a container.
    pub resident_gen: i64
    /// The held generation's bytes, empty when none is held.
    pub resident_bytes: Vec<u8>
    /// Bytes a held generation may occupy, or 0 to hold none.
    pub resident_budget: i64
    /// The exclusive lock a writer holds on the directory, for as long as it is
    /// open. A reader takes none.
    lock: Option<fs::File>
    /// What the open found wrong with the log and read past, one line each.
    ///
    /// A store that recovers to its last good commit is still a store, so this
    /// is not a refusal to open; it is what a caller says out loud instead of
    /// serving a log that quietly ends early.
    pub faults: Vec<String>
    in_batch: bool
    batch_start: i64
    staged: Vec<batch::Staged>
}

/// Opens the store in `dir`, rebuilding the index from the generations already there.
pub fn open(dir: String, read_only: bool = false) -> Result<Store, String> {
    ensure_dir(dir, read_only)?
    let mut st = empty_store(dir, read_only)
    if !read_only { st.lock = Some(write_lock(dir)?) }
    let gens = log::data_generations(dir)?
    // The generation without a hint file beside it is the one writes went to,
    // and how far its records reach is where the next one goes.
    let unsealed, unsealed_end = rebuild(&mut st, dir, gens)
    if read_only {
        st.gen = if unsealed > 0 { unsealed } else { newest_or(gens, 1) }
        // A reader opens every generation it might read before it answers
        // anything. That keeps the first read off the open path, and it leaves
        // the store's own state untouched while it serves, which is what lets
        // several readers work from one store at the same time.
        warm_readers(&mut st, gens)
        rows::admit_resident(&mut st, gens)
        return Ok(st)
    }
    // Writes go above every generation the directory holds. Generations are
    // replayed in order, so a sealed one above the active file would be read
    // back over the records appended below it.
    let newest = newest_or(gens, 0)
    if unsealed == newest && unsealed > 0 {
        st.gen = unsealed
        st.cur_off = unsealed_end
    } else {
        st.gen = newest + 1
        st.cur_off = 0
    }
    st.data = Some(log::open_append(log::data_path(dir, st.gen))?)
    log::sync_dir(dir)?
    Ok(st)
}

// The store admits one writer, which holds this for as long as it is open. Two
// writers would interleave their appends into one active file, so the second is
// told rather than left to find out.
fn write_lock(dir: String) -> Result<fs::File, String> {
    let f = log::open_append(log::lock_path(dir))?
    match f.try_lock_exclusive() {
        Ok(true) => Ok(f)
        Ok(false) => Err("open: " + dir + " is already open for writing")
        Err(e) => Err("open: lock: " + e.message())
    }
}

// A path already holding something else is not a store, and creating a
// directory cannot make it into one, so the two cases are separated before the
// create rather than left to the errno it would answer with.
fn ensure_dir(dir: String, read_only: bool) -> Result<(), String> {
    if fs::is_dir(dir) { return Ok(()) }
    if fs::exists(dir) { return Err("open: not a directory: " + dir) }
    if read_only { return Err("open: no store at " + dir) }
    match fs::create_dir_all(dir) {
        Ok(_) => Ok(())
        Err(e) => Err("open: " + e.message())
    }
}

// A store with nothing in it, before the log is read back.
fn empty_store(dir: String, read_only: bool) -> Store {
    Store {
        dir: dir, gen: 0, index: Map::new(), data: None, cur_off: 0
        read_only: read_only, live_bytes: 0, dead_bytes: 0, readers: Map::new()
        tables: #[]
        durable: true, auto_compact: compact::AUTO_COMPACT_RATIO, in_batch: false, batch_start: 0, staged: #[]
        resident_gen: 0
        resident_bytes: #[]
        resident_budget: rows::RESIDENT_BUDGET
        lock: None
        faults: #[]
    }
}

// Fills the index from every generation the directory holds: from a sealed
// generation's hint file where there is one, and from the data file otherwise.
// Answers the unsealed generation and where its records end.
fn rebuild(st: &mut Store, dir: String, gens: Vec<i64>) -> (i64, i64) {
    let mut unsealed: i64 = 0
    let mut unsealed_end: i64 = 0
    for g in gens {
        if fs::is_file(log::hint_path(dir, g)) {
            // A hint describes a data file rather than replacing it, so a hint
            // that cannot be read or that stops short of describing every
            // record is answered by reading the records themselves.
            if !from_hints(st, dir, g) {
                let _ = recover::rebuild_from_data(st, g, log::data_path(dir, g))
            }
        } else {
            unsealed = g
            unsealed_end = recover::rebuild_from_data(st, g, log::data_path(dir, g))
        }
    }
    (unsealed, unsealed_end)
}

// Whether generation `gen` was rebuilt whole from its hint file.
fn from_hints(st: &mut Store, dir: String, gen: i64) -> bool {
    match log::read_whole(log::hint_path(dir, gen)) {
        Ok(buf) => recover::rebuild_from_hints(st, gen, buf)
        Err(_) => false
    }
}

// The highest generation present, or `fallback` when the directory is empty.
fn newest_or(gens: Vec<i64>, fallback: i64) -> i64 {
    if gens.len() == 0 { return fallback }
    gens[gens.len() - 1]
}

pub (package) fn append(st: &mut Store, rec: Vec<u8>) -> Result<i64, String> {
    if st.read_only { return Err("store is read-only") }
    let off = st.cur_off
    match st.data {
        Some(f) => {
            match f.write_at(rec, off) {
                Ok(n) => {
                    if n != rec.len() { return Err("short write: " + n.to_string() + " of " + rec.len().to_string() + " bytes") }
                }
                Err(e) => return Err("write: " + e.message())
            }
        }
        None => return Err("store not open for writing")
    }
    st.cur_off = off + rec.len()
    Ok(off)
}

/// The operations every key in the store is reached through.
impl Store {
    /// Stores `val` under `key`, replacing any previous value.
    pub fn put(&mut self, key: String, val: Vec<u8>) -> Result<(), String> {
        if key == "" { return Err("put: key must not be empty") }
        if key.byte_len() > MAX_KEY_LEN { return Err("put: key exceeds " + MAX_KEY_LEN.to_string() + " bytes") }
        if val.len() > MAX_VALUE_LEN { return Err("put: value exceeds " + MAX_VALUE_LEN.to_string() + " bytes") }
        let alone = batch::solo(self)
        if alone { batch::begin(self)? }
        let gen = self.gen
        let crc = log::record_crc(key, val)
        let off = match append(self, log::record(key, log::KIND_PUT, val, crc)) {
            Ok(o) => o
            Err(e) => return Err(if alone { batch::undo(self, e) } else { e })
        }
        self.staged.push(batch::Staged { key: key, entry: Entry { file: gen, offset: off, vlen: val.len(), crc: crc }, remove: false })
        if alone { batch::commit(self)? }
        Ok(())
    }

    /// Removes `key`, reporting whether it was present.
    pub fn delete(&mut self, key: String) -> Result<bool, String> {
        if !self.contains(key) && !batch::staged_holds(self, key) { return Ok(false) }
        let alone = batch::solo(self)
        if alone { batch::begin(self)? }
        if let Err(e) = append(self, log::record(key, log::KIND_DELETE, #[], log::record_crc(key, #[]))) {
            return Err(if alone { batch::undo(self, e) } else { e })
        }
        self.staged.push(batch::Staged { key: key, entry: Entry { file: 0, offset: 0, vlen: 0, crc: 0 }, remove: true })
        if alone { batch::commit(self)? }
        Ok(true)
    }

    /// Reads the value stored under `key`.
    ///
    /// A key the index names must be readable, so a record that cannot be read or
    /// fails its checksum is a [`Read::Fault`] rather than a [`Read::Absent`]: a
    /// fault in the store is not the same answer as a key that was never written.
    pub fn get(&mut self, key: String) -> Read {
        let tid, rid = rows::locate_row(self, key)
        if tid >= 0 {
            // The row read's answer is handed on as it stands, so a hit costs no
            // second carrier.
            match rows::read(self, tid, rid) {
                Read::Value(v) => return Read::Value(v)
                Read::Fault(e) => return Read::Fault(e)
                Read::Absent => ()
            }
        }
        let e = match self.index.get(key) {
            Some(e) => e
            None => return Read::Absent
        }
        if e.file == self.gen {
            if let Some(f) = self.data { return read_record(f, key, e) }
        }
        match reader_for(self, e.file) {
            Some(f) => read_record(f, key, e)
            None => Read::Fault("'" + key + "': generation " + e.file.to_string() + " cannot be opened")
        }
    }

    /// Whether `key` is live, without reading its value.
    pub fn contains(&mut self, key: String) -> bool {
        let tid, rid = rows::locate_row(self, key)
        if tid >= 0 && rows::holds(self, tid, rid) { return true }
        self.index.contains(key)
    }

    /// Number of live keys in the store, rows included.
    pub fn len(&self) -> i64 {
        let mut n = self.index.len()
        let mut t: i64 = 0
        while t < self.tables.len() {
            n += self.tables[t].live
            t += 1
        }
        n
    }

    /// Makes every completed write durable.
    pub fn sync(&mut self) -> Result<(), String> {
        if let Some(f) = self.data {
            if let Err(e) = f.sync_all() { return Err("sync: " + e.message()) }
        }
        Ok(())
    }
}

// Sealed generations are immutable, so one handle per generation serves every
// read of it and a get costs no open.
pub (package) fn reader_for(st: &mut Store, gen: i64) -> Option<fs::File> {
    if let Some(f) = st.readers.get(gen) { return Some(f) }
    match log::open_read(log::data_path(st.dir, gen)) {
        Some(f) => {
            st.readers.insert(gen, f)
            Some(f)
        }
        None => None
    }
}

// Opens a handle for every generation up front, so a reader never touches its
// own state while it is answering.
fn warm_readers(st: &mut Store, gens: Vec<i64>) {
    for g in gens {
        let _ = reader_for(st, g)
    }
}

// One positional read, and the value buffer is returned exactly as it came
// back: copying a Vec costs far more per byte than the read costs per call, and
// each call the read path avoids is a call the runtime does not have to make.
//
// The checksum is continued from the key the caller asked for rather than from
// the key on disk, and compared against the one the index carries. That checks
// more than a header re-read would: a record whose stored key differs from the
// one being looked up fails exactly as a corrupted value does.
fn read_record(f: fs::File, key: String, e: Entry) -> Read {
    let value = match f.read_at(e.vlen, e.offset + log::HEADER_LEN + key.byte_len()) {
        Ok(v) => v
        Err(err) => return Read::Fault("'" + key + "': " + err.message())
    }
    if value.len() != e.vlen {
        return Read::Fault("'" + key + "': " + value.len().to_string() + " of " +
            e.vlen.to_string() + " bytes readable")
    }
    if log::record_crc(key, value) != e.crc { return Read::Fault("'" + key + "': checksum mismatch") }
    Read::Value(value)
}

#[cfg(test)]
mod tests {
    use std::fs
    use crate::kv

    fn fresh(name: String) -> String {
        let dir = "/tmp/terndb_kv_test/" + name
        let _ = fs::remove_dir_all(dir)
        let _ = fs::create_dir_all(dir)
        dir
    }

    fn opened(dir: String) -> super::Store {
        super::open(dir, false).unwrap_or_else(|e| panic("open " + dir + ": " + e))
    }

    // The bytes a read answered, with an absence or a fault failing the test.
    fn must_get_of(r: kv::Read) -> Vec<u8> {
        match r {
            kv::Read::Value(v) => return v
            kv::Read::Absent => {
                assert(false, "expected a value")
                return #[]
            }
            kv::Read::Fault(e) => {
                assert(false, e)
                return #[]
            }
        }
    }

    fn must_get(st: &mut super::Store, key: String) -> Vec<u8> {
        match st.get(key) {
            kv::Read::Value(v) => return v
            kv::Read::Fault(e) => panic(e)
            kv::Read::Absent => {
                assert(false, "expected a value for '" + key + "'")
                return #[]
            }
        }
    }

    #[test]
    fn put_then_get_returns_the_stored_bytes() {
        let mut st = opened(fresh("put_get"))
        assert(st.put("alpha", #[1u8, 2, 3]).is_ok())
        assert(st.put("beta", #[4u8, 5]).is_ok())
        assert_eq(must_get(&mut st, "alpha"), #[1u8, 2, 3])
        assert_eq(must_get(&mut st, "beta"), #[4u8, 5])
        assert(matches(st.get("missing"), kv::Read::Absent))
        assert_eq(st.len(), 2)
    }

    #[test]
    fn a_later_put_supersedes_the_earlier_value() {
        let mut st = opened(fresh("overwrite"))
        assert(st.put("k", #[1u8]).is_ok())
        assert(st.put("k", #[9u8, 9]).is_ok())
        assert_eq(must_get(&mut st, "k"), #[9u8, 9])
        assert_eq(st.len(), 1, "an overwrite does not add a key")
        assert(st.dead_bytes > 0, "the superseded record is accounted as dead")
    }

    #[test]
    fn delete_reports_presence_and_hides_the_key() {
        let mut st = opened(fresh("delete"))
        assert(st.put("k", #[1u8]).is_ok())
        assert_eq(st.delete("k").unwrap_or(false), true)
        assert(matches(st.get("k"), kv::Read::Absent))
        assert_eq(st.delete("k").unwrap_or(true), false, "a second delete reports absent")
        assert_eq(st.delete("never").unwrap_or(true), false)
        assert_eq(st.len(), 0)
    }

    #[test]
    fn an_empty_value_is_distinct_from_an_absent_key() {
        let mut st = opened(fresh("empty_value"))
        assert(st.put("k", #[]).is_ok())
        assert_eq(must_get(&mut st, "k"), #[])
        assert(matches(st.get("other"), kv::Read::Absent))
    }

    #[test]
    fn keys_and_values_may_hold_arbitrary_bytes() {
        let mut st = opened(fresh("utf8"))
        let key = "táblé/rów/日本語"
        let val = "héllo wörld 🌍".as_bytes()
        assert(st.put(key, val).is_ok())
        assert_eq(must_get(&mut st, key), val)
        let mut all: Vec<u8> = #[]
        let mut i: i64 = 0
        while i < 256 {
            all.push(i as u8)
            i += 1
        }
        assert(st.put("bytes", all).is_ok())
        assert_eq(must_get(&mut st, "bytes"), all)
    }

    #[test]
    fn put_rejects_input_outside_the_documented_limits() {
        let mut st = opened(fresh("limits"))
        assert(st.put("", #[1u8]).is_err(), "an empty key is rejected")
        assert(st.put("k", #[0u8; 1_048_577]).is_err(), "a value over 1 MiB is rejected")
        assert(st.put("k", #[0u8; 1_048_576]).is_ok(), "a value at exactly 1 MiB is accepted")
    }

    #[test]
    fn a_corrupt_record_body_stops_the_replay_and_is_reported() {
        let dir = fresh("corrupt")
        let mut st = opened(dir)
        assert(st.put("first", #[1u8, 2, 3, 4]).is_ok())
        assert(st.put("k", #[1u8, 2, 3, 4]).is_ok())
        assert(st.sync().is_ok())
        let path = kv::log::data_path(dir, st.gen)
        let mut bytes = fs::read(path).unwrap_or(#[])
        assert(bytes.len() > 0)
        // Flip a byte of the second record's value, leaving its header and the
        // CRC that record was written with untouched.
        let at = bytes.len() - kv::log::HEADER_LEN - 1
        bytes[at] = bytes[at] + 1u8
        assert(fs::write(path, bytes).is_ok())

        let mut after = opened(dir)
        assert(matches(after.get("k"), kv::Read::Absent)
            "the replay stops at a record it cannot verify")
        assert_eq(must_get_of(after.get("first"))
            #[1u8, 2, 3, 4], "what the log holds before the fault is still there")
        assert_eq(after.faults.len(), 1, "a store that read past a fault says so")
        assert(after.faults[0].contains("failed its checksum"), "got: " + after.faults[0])
    }

    #[test]
    fn a_second_writer_is_refused_while_the_first_holds_the_store() {
        let dir = fresh("one_writer")
        let mut st = opened(dir)
        assert(st.put("k", #[1u8]).is_ok())
        // A reader shares nothing mutable with the writer and is not refused.
        assert(super::open(dir, true).is_ok(), "a reader takes no lock")
        assert(fs::is_file(kv::log::lock_path(dir)), "the writer's lock is a file of its own")
    }

    #[test]
    fn a_record_whose_stored_key_was_altered_is_not_returned() {
        let dir = fresh("corrupt_key")
        let mut st = opened(dir)
        assert(st.put("alpha", #[1u8, 2, 3, 4]).is_ok())
        assert(st.sync().is_ok())
        let path = kv::log::data_path(dir, st.gen)
        let mut bytes = fs::read(path).unwrap_or(#[])
        // The key sits directly after the 11-byte header.
        bytes[11] = bytes[11] + 1u8
        assert(fs::write(path, bytes).is_ok())

        let mut after = opened(dir)
        assert(matches(after.get("alpha"), kv::Read::Absent), "the altered key no longer names this record")
    }

    #[test]
    fn a_read_only_store_reads_but_refuses_writes() {
        let dir = fresh("read_only")
        let mut writer = opened(dir)
        assert(writer.put("k", #[1u8]).is_ok())
        assert(writer.sync().is_ok())

        let mut reader = match super::open(dir, true) {
            Ok(s) => s
            Err(e) => {
                assert(false, e)
                return
            }
        }
        assert_eq(must_get(&mut reader, "k"), #[1u8])
        assert(reader.put("k", #[2u8]).is_err(), "a read-only store refuses a put")
        assert(reader.delete("k").is_err(), "a read-only store refuses a delete")
        assert(kv::compact::run(&mut reader).is_err(), "a read-only store refuses a compaction")
        assert(super::open("/tmp/terndb_kv_test/does_not_exist_at_all", true).is_err())
    }

    #[test]
    fn a_store_that_cannot_be_opened_says_so() {
        // Read-only never creates: a directory that is not there is an error,
        // where a writer would have made it.
        let missing = "/tmp/terndb_kv_test/never_created"
        let _ = fs::remove_dir_all(missing)
        match super::open(missing, true) {
            Ok(_) => assert(false, "a reader does not create a store")
            Err(e) => assert(e.contains("no store at") && e.contains(missing), "got: " + e)
        }
        assert(super::open(missing, false).is_ok(), "a writer does")
        // A file is not a directory either way, and a writer says that rather
        // than reporting what creating a directory over it would answer with.
        let dir = fresh("not_a_dir")
        let path = dir + "/plain"
        assert(fs::write(path, "x".as_bytes()).is_ok())
        for read_only in #[true, false] {
            match super::open(path, read_only) {
                Ok(_) => assert(false, "a file is not a store")
                Err(e) => {
                    assert(e.contains("not a directory"), "got: " + e)
                    // The path is named once: a wrapper that restates what the
                    // underlying error already carries reads it twice.
                    assert_eq(e.count(path), 1, "got: " + e)
                }
            }
        }
    }

    #[test]
    fn a_read_only_store_refuses_every_way_of_writing() {
        let dir = fresh("read_only_writes")
        let mut writer = opened(dir)
        let tid = kv::rows::open_table(&mut writer, "t")
        assert(kv::rows::write(&mut writer, tid, 1, #[1u8]).is_ok())
        assert(writer.sync().is_ok())

        let mut reader = super::open(dir, true).unwrap_or_else(|e| panic(e))
        let rt = kv::rows::table_id(&mut reader, "t")
        assert(reader.put("k", #[1u8]).is_err())
        assert(kv::rows::write(&mut reader, rt, 2, #[1u8]).is_err())
        assert(kv::batch::begin(&mut reader).is_err())
        assert(kv::compact::run(&mut reader).is_err())
        assert(!kv::compact::due(&mut reader), "a reader never merges")
        // Reading still works, and sync is a no-op rather than a failure.
        assert_eq(must_get_of(kv::rows::read(&mut reader, rt, 1)), #[1u8])
        assert(reader.sync().is_ok())
    }

    #[test]
    fn many_keys_round_trip_through_a_restart() {
        let dir = fresh("bulk")
        let mut st = opened(dir)
        let n: i64 = 500
        let mut i: i64 = 0
        while i < n {
            assert(st.put("key/" + i.to_string(), ("value-" + i.to_string()).as_bytes()).is_ok())
            i += 1
        }
        assert(st.sync().is_ok())
        let mut after = opened(dir)
        assert_eq(after.len(), n)
        let mut j: i64 = 0
        while j < n {
            assert_eq(must_get(&mut after, "key/" + j.to_string()), ("value-" + j.to_string()).as_bytes(), "key " + j.to_string())
            j += 1
        }
    }
}
