// Datetime values: RFC 3339 text in UTC over epoch milliseconds, with the
// proleptic Gregorian calendar arithmetic that converts between the two.

/// Renders epoch milliseconds as RFC 3339 in UTC, always with a millisecond field.
pub fn render(ms: i64) -> String {
    let days = floor_div(ms, 86_400_000)
    let rem = ms - days * 86_400_000
    let millis = rem % 1000
    let secs = rem / 1000
    let y, mo, d = civil_from_days(days)
    format("{:04}-{:02}-{:02}T{:02}:{:02}:{:02}.{:03}Z"
        y, mo, d, secs / 3600, (secs % 3600) / 60, secs % 60, millis)
}

/// Parses `YYYY-MM-DDTHH:MM:SS[.fff][Z]` (a space separator is also accepted) into epoch millis.
pub fn parse(s: String) -> Result<i64, String> {
    if s.len() < 19 { return Err("datetime: expected YYYY-MM-DDTHH:MM:SS, got '" + s + "'") }
    let sep = s[10]
    if s[4] != '-' || s[7] != '-' || (sep != 'T' && sep != ' ') || s[13] != ':' || s[16] != ':' {
        return Err("datetime: malformed separators in '" + s + "'")
    }
    let y = parse_field(s, 0, 4)?
    let mo = parse_field(s, 5, 2)?
    let d = parse_field(s, 8, 2)?
    let h = parse_field(s, 11, 2)?
    let mi = parse_field(s, 14, 2)?
    let se = parse_field(s, 17, 2)?
    if mo < 1 || mo > 12 { return Err("datetime: month out of range in '" + s + "'") }
    if d < 1 || d > days_in_month(y, mo) { return Err("datetime: day out of range in '" + s + "'") }
    if h > 23 || mi > 59 || se > 59 { return Err("datetime: time out of range in '" + s + "'") }
    let mut ms: i64 = 0
    if s.len() > 19 && s[19] == '.' {
        let mut seen: i64 = 0
        let mut i: i64 = 20
        while i < s.len() && s[i] >= '0' && s[i] <= '9' {
            if seen < 3 { ms = ms * 10 + (s[i] as i64 - 48) }
            seen += 1
            i += 1
        }
        if seen == 0 { return Err("datetime: empty fractional second in '" + s + "'") }
        while seen < 3 {
            ms = ms * 10
            seen += 1
        }
    }
    Ok(days_from_civil(y, mo, d) * 86_400_000 + (h * 3600 + mi * 60 + se) * 1000 + ms)
}

fn parse_field(s: String, start: i64, n: i64) -> Result<i64, String> {
    let mut v: i64 = 0
    let mut i = start
    while i < start + n {
        let c = s[i]
        if c < '0' || c > '9' { return Err("datetime: expected a digit at offset " + i.to_string()) }
        v = v * 10 + (c as i64 - 48)
        i += 1
    }
    Ok(v)
}

/// Whether a proleptic Gregorian year is a leap year.
pub fn is_leap_year(y: i64) -> bool {
    y % 4 == 0 && (y % 100 != 0 || y % 400 == 0)
}

/// Number of days in a month of a proleptic Gregorian year.
pub fn days_in_month(y: i64, m: i64) -> i64 {
    if m == 2 { return if is_leap_year(y) { 29 } else { 28 } }
    if m == 4 || m == 6 || m == 9 || m == 11 { return 30 }
    31
}

/// Days since 1970-01-01 for a proleptic Gregorian date (Howard Hinnant's algorithm).
pub fn days_from_civil(y: i64, m: i64, d: i64) -> i64 {
    let y2 = y - (if m <= 2 { 1 } else { 0 })
    let era = floor_div(y2, 400)
    let yoe = y2 - era * 400
    let mp = (m + 9) % 12
    let doy = (153 * mp + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146_097 + doe - 719_468
}

/// The proleptic Gregorian date for a count of days since 1970-01-01.
pub fn civil_from_days(z: i64) -> (i64, i64, i64) {
    let z2 = z + 719_468
    let era = floor_div(z2, 146_097)
    let doe = z2 - era * 146_097
    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    let m = if mp < 10 { mp + 3 } else { mp - 9 }
    (yoe + era * 400 + (if m <= 2 { 1 } else { 0 }), m, d)
}

/// Integer division that rounds toward negative infinity.
pub fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b
    if a % b != 0 && (a < 0) != (b < 0) { return q - 1 }
    q
}

#[cfg(test)]
mod tests {
    #[test]
    fn datetime_parses_and_formats_the_same_instant() {
        match super::parse("2023-11-14T22:13:20.123Z") {
            Ok(ms) => {
                assert_eq(ms, 1_700_000_000_123)
                assert_eq(super::render(ms), "2023-11-14T22:13:20.123Z")
            }
            Err(e) => assert(false, e)
        }
        assert_eq(super::parse("1970-01-01T00:00:00Z").unwrap_or(-1), 0)
        assert_eq(super::render(0), "1970-01-01T00:00:00.000Z")
    }

    #[test]
    fn datetime_accepts_the_documented_spellings() {
        let want = super::parse("2023-11-14T22:13:20Z").unwrap_or(-1)
        assert(want > 0)
        assert_eq(super::parse("2023-11-14T22:13:20").unwrap_or(-1), want, "trailing Z is optional")
        assert_eq(super::parse("2023-11-14 22:13:20Z").unwrap_or(-1), want, "a space separator is accepted")
        assert_eq(super::parse("2023-11-14T22:13:20.5Z").unwrap_or(-1), want + 500, "one fractional digit is tenths")
        assert_eq(super::parse("2023-11-14T22:13:20.123456Z").unwrap_or(-1), want + 123, "extra digits are truncated")
    }

    #[test]
    fn datetime_rejects_malformed_input() {
        let bad = #[
            "", "2023-11-14", "2023/11/14T22:13:20Z", "2023-11-14X22:13:20Z"
            "2023-13-01T00:00:00Z", "2023-02-30T00:00:00Z", "2023-11-14T24:00:00Z"
            "2023-11-14T00:60:00Z", "20x3-11-14T22:13:20Z", "2023-11-14T22:13:20.Z"
        ]
        for s in bad { assert(super::parse(s).is_err(), "must reject '" + s + "'") }
        assert(super::parse("2024-02-29T00:00:00Z").is_ok(), "2024 is a leap year")
        assert(super::parse("2023-02-29T00:00:00Z").is_err(), "2023 is not a leap year")
    }

    #[test]
    fn datetime_roundtrips_across_the_epoch_and_leap_days() {
        let stamps = #[
            "1970-01-01T00:00:00.000Z", "1969-12-31T23:59:59.999Z", "1900-03-01T12:00:00.000Z"
            "2000-02-29T23:59:59.001Z", "2024-02-29T00:00:00.000Z", "2100-03-01T00:00:00.000Z"
            "9999-12-31T23:59:59.999Z", "0001-01-01T00:00:00.000Z"
        ]
        for s in stamps {
            match super::parse(s) {
                Ok(ms) => assert_eq(super::render(ms), s)
                Err(e) => assert(false, s + ": " + e)
            }
        }
    }

    #[test]
    fn civil_and_days_are_inverses_over_a_long_run() {
        let mut day: i64 = -25_000
        while day < 25_000 {
            let y, m, d = super::civil_from_days(day)
            assert_eq(super::days_from_civil(y, m, d), day, "day " + day.to_string())
            day += 7
        }
    }

    #[test]
    fn floor_div_rounds_toward_negative_infinity() {
        assert_eq(super::floor_div(7, 2), 3)
        assert_eq(super::floor_div(-7, 2), -4)
        assert_eq(super::floor_div(-1, 86_400_000), -1)
        assert_eq(super::floor_div(0, 5), 0)
    }
}
