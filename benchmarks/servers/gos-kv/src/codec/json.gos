use crate::codec

// A row's JSON spelling, rendered straight from the encoded bytes.
//
// A read that answers JSON never builds a `codec::Value`: the render walks the record
// the store handed back and writes each column into the answer as it goes,
// which is the whole of what the key-value front end does above the store.

/// A row's JSON spelling resolved once from its column names.
///
/// `keys` holds the `,"<name>":` fragment each column is written under, and a
/// column whose value is `true`, `false`, or `null` is written as one piece
/// with its key, so a render appends one piece for it rather than two.
///
/// A statement's columns are settled when it is planned, so this belongs
/// wherever the plan does; [`render`] takes what [`render_plan`] produces.
pub struct RenderPlan {
    pub keys: Vec<String>
    trues: Vec<String>
    falses: Vec<String>
    nulls: Vec<String>
}

/// The render plan for columns `names`, in the order a row encodes them.
pub fn render_plan(names: Vec<String>) -> RenderPlan {
    let mut plan = RenderPlan { keys: #[], trues: #[], falses: #[], nulls: #[] }
    for name in names {
        let key = ",\"" + name + "\":"
        plan.trues.push(key + "true")
        plan.falses.push(key + "false")
        plan.nulls.push(key + "null")
        plan.keys.push(key)
    }
    plan
}

/// Renders one row's encoded columns as `{"id":<id>,"<name>":<value>,...}`,
/// or the empty string when the buffer does not hold them all.
///
/// `plan` is what [`render_plan`] builds for the columns in the order the row
/// encodes them.
///
/// The row is read once, straight into the answer: no `codec::Value` is built and no
/// column is turned into a string of its own on the way, which is the work a
/// request answering a row as JSON does not otherwise need.
pub fn render(buf: Vec<u8>, plan: RenderPlan, id: i64) -> String {
    render_window(buf, 0, buf.len(), plan, id)
}

/// The same rendering over `buf[start..end]`, for a caller holding the row
/// inside a larger buffer.
///
/// A store that keeps a sealed file in memory reads a row by naming where it
/// sits rather than by copying it out, so the render is the only pass over
/// those bytes.
pub fn render_window(buf: Vec<u8>, start: i64, end: i64, plan: RenderPlan, id: i64) -> String {
    let mut out = String::with_capacity(16 + plan.keys.len() * 24 + (end - start))
    if render_window_into(&mut out, buf, start, end, plan, id) { out } else { "" }
}

/// Appends the rendering of `buf[start..end]` to `out`, answering whether the
/// buffer held the whole row.
///
/// A caller answering many rows keeps one `out`, cleared between them, so a
/// read allocates nothing once the buffer has grown to a row's size. A row
/// the buffer does not hold leaves `out` as it was.
pub fn render_window_into(out: &mut String, buf: Vec<u8>, start: i64, end: i64, plan: RenderPlan, id: i64) -> bool {
    let mark = out.byte_len()
    if render_columns(out, buf, start, end, plan, id) { return true }
    out.truncate(mark)
    false
}

fn render_columns(out: &mut String, buf: Vec<u8>, start: i64, end: i64, plan: RenderPlan, id: i64) -> bool {
    let cols = plan.keys.len()
    out.push_str("{\"id\":")
    out.push_str(id.to_string())
    let n = end
    let mut p: i64 = start
    let mut c: i64 = 0
    // The row is read straight into the answer, one column at a time: no
    // `Value` is built, and the buffer is read where it lies.
    while c < cols {
        if p >= n { return false }
        let tag = buf[p]
        p += 1
        // A column that renders as one of three words is written with its key
        // in one piece; every other value follows its key.
        if tag == codec::TAG_NIL {
            out.push_str(plan.nulls[c])
            c += 1
            continue
        }
        if tag == codec::TAG_BOOL {
            if p + 1 > n { return false }
            if buf[p] != 0u8 { out.push_str(plan.trues[c]) } else { out.push_str(plan.falses[c]) }
            p += 1
            c += 1
            continue
        }
        out.push_str(plan.keys[c])
        match tag {
            codec::TAG_I8 => {
                if p + 1 > n { return false }
                out.push_str((buf[p] as i8 as i64).to_string())
                p += 1
            }
            codec::TAG_I16 => {
                if p + 2 > n { return false }
                out.push_str(sign_extend((buf[p] as i64) | ((buf[p + 1] as i64) << 8), 2).to_string())
                p += 2
            }
            codec::TAG_I32 => {
                if p + 4 > n { return false }
                out.push_str(sign_extend(u32_at(buf, p), 4).to_string())
                p += 4
            }
            codec::TAG_I64 => {
                if p + 8 > n { return false }
                out.push_str(i64_at(buf, p).to_string())
                p += 8
            }
            codec::TAG_DT => {
                if p + 8 > n { return false }
                out.push_str("\"")
                out.push_str(datetime::render(i64_at(buf, p)))
                out.push_str("\"")
                p += 8
            }
            codec::TAG_F32 | codec::TAG_F64 => {
                if p + 8 > n { return false }
                out.push_str(f64::from_bits(i64_at(buf, p) as u64).to_string())
                p += 8
            }
            codec::TAG_TEXT => {
                if p + 4 > n { return false }
                let body = p + 4
                let stop = body + u32_at(buf, p)
                if stop > n { return false }
                if !out.push_json_quoted(buf, body, stop) { return false }
                p = stop
            }
            _ => return false
        }
        c += 1
    }
    out.push_str("}")
    true
}

// A raw fixed-width field read as the signed integer it stands for.
fn sign_extend(raw: i64, width: i64) -> i64 {
    let sign = 1 << (8 * width - 1)
    if raw >= sign { raw - 2 * sign } else { raw }
}

// The four little-endian bytes at `p`, unsigned. A fixed-width field is a
// handful of shifts, where a slice of the buffer would be an allocation.
fn u32_at(buf: Vec<u8>, p: i64) -> i64 {
    (buf[p] as i64) | ((buf[p + 1] as i64) << 8) | ((buf[p + 2] as i64) << 16) | ((buf[p + 3] as i64) << 24)
}

// The eight little-endian bytes at `p`, read by index. A fixed-width field is
// a handful of shifts, where a slice of the buffer would be an allocation.
fn i64_at(buf: Vec<u8>, p: i64) -> i64 {
    let lo = (buf[p] as i64) | ((buf[p + 1] as i64) << 8) | ((buf[p + 2] as i64) << 16) | ((buf[p + 3] as i64) << 24)
    let hi = (buf[p + 4] as i64) | ((buf[p + 5] as i64) << 8) | ((buf[p + 6] as i64) << 16) | ((buf[p + 7] as i64) << 24)
    (hi << 32) | lo
}

/// One decoded value in the JSON spelling [`render`] gives it.
///
/// This is the projection path's renderer: a statement naming its columns out
/// of table order has to reach them through the decoded row, and renders each
/// the same way a whole row does.
pub fn value(v: codec::Value) -> String {
    if v.tag == codec::TAG_NIL { return "null" }
    if v.tag == codec::TAG_BOOL { return if v.b { "true" } else { "false" } }
    if v.tag == codec::TAG_TEXT { return "\"" + escape(v.s) + "\"" }
    if v.tag == codec::TAG_DT { return "\"" + datetime::render(v.i) + "\"" }
    if v.tag == codec::TAG_F32 || v.tag == codec::TAG_F64 { return v.f.to_string() }
    v.i.to_string()
}

// `text` with the two characters JSON reserves inside a string escaped, and
// anything below a space written as an escape of its own. A string holding none
// of them is its own answer, which is what almost every column is.
fn escape(text: String) -> String {
    let n = text.byte_len()
    let mut i: i64 = 0
    while i < n {
        let b = text.byte_at(i)
        if b == 34 || b == 92 || b < 32 { break }
        i += 1
    }
    if i == n { return text }
    let mut out = String::with_capacity(n + 8)
    for ch in text {
        let code = ch as i64
        match code {
            34 => out.push_str("\\\"")
            92 => out.push_str("\\\\")
            10 => out.push_str("\\n")
            13 => out.push_str("\\r")
            9 => out.push_str("\\t")
            _ => {
                if code < 32 {
                    out.push_str("\\u00")
                    out.push_str(hex_byte(code))
                } else {
                    out.push_str(ch.to_string())
                }
            }
        }
    }
    out
}

// Two lowercase hex digits of a byte, for the escapes JSON spells that way.
fn hex_byte(v: i64) -> String {
    let digits = "0123456789abcdef"
    digits[(v >> 4) & 15].to_string() + digits[v & 15].to_string()
}

#[cfg(test)]
mod tests {
    use crate::codec

    #[test]
    fn a_row_renders_as_json_without_materialising_values() {
        let mut buf: Vec<u8> = #[]
        codec::encode_into(&mut buf, codec::Value::text("user-1"))
        codec::encode_into(&mut buf, codec::Value::text("u\"q\\b"))
        codec::encode_into(&mut buf, codec::Value::float(1.5))
        codec::encode_into(&mut buf, codec::Value::bool(true))
        codec::encode_into(&mut buf, codec::Value::nil())
        assert_eq(super::render(buf, super::render_plan(#["name", "email", "score", "active", "note"]), 7)
            "{\"id\":7,\"name\":\"user-1\",\"email\":\"u\\\"q\\\\b\",\"score\":1.5,\"active\":true,\"note\":null}")
        assert_eq(super::render(buf.slice(0, 5).unwrap_or(#[]), super::render_plan(#["name"]), 1), "", "a truncated row is refused")
    }

    #[test]
    fn a_row_renders_onto_what_the_buffer_already_holds() {
        let mut buf: Vec<u8> = #[]
        codec::encode_into(&mut buf, codec::Value::text("x"))
        codec::encode_into(&mut buf, codec::Value::int(3))
        let keys = super::render_plan(#["a", "b"])
        let mut out = "["
        assert(super::render_window_into(&mut out, buf, 0, buf.len(), keys, 1))
        assert_eq(out, "[{\"id\":1,\"a\":\"x\",\"b\":3}")
        // A row the window does not hold whole leaves the buffer as it was.
        assert(!super::render_window_into(&mut out, buf, 0, buf.len() - 1, keys, 2))
        assert_eq(out, "[{\"id\":1,\"a\":\"x\",\"b\":3}")
    }

    #[test]
    fn escapes_survive_beside_the_multi_byte_text_around_them() {
        // Every byte JSON escapes is ASCII, so a run of text may be cut at one.
        // The cut has to leave the multi-byte characters either side of it
        // whole, which is what this pins.
        let raw = "é\"🌍\\x\u{1}y\tz"
        let mut buf: Vec<u8> = #[]
        codec::encode_into(&mut buf, codec::Value::text(raw))
        assert_eq(super::render(buf, super::render_plan(#["t"]), 3)
            "{\"id\":3,\"t\":\"é\\\"🌍\\\\x\\u0001y\\tz\"}")
        // A text column with nothing to escape, and an empty one.
        let mut plain: Vec<u8> = #[]
        codec::encode_into(&mut plain, codec::Value::text("héllo 🌍"))
        codec::encode_into(&mut plain, codec::Value::text(""))
        assert_eq(super::render(plain, super::render_plan(#["a", "b"]), 1)
            "{\"id\":1,\"a\":\"héllo 🌍\",\"b\":\"\"}")
        // A row whose text length runs past the buffer is refused rather than
        // rendered short.
        let mut cut: Vec<u8> = #[]
        codec::encode_into(&mut cut, codec::Value::text("abcdefgh"))
        assert_eq(super::render(cut.slice(0, 8).unwrap_or(#[]), super::render_plan(#["a"]), 1), "")
    }

    #[test]
    fn every_rendered_column_matches_the_value_it_encodes() {
        let vals = #[codec::Value::int8(-8), codec::Value::int16(-300), codec::Value::int32(70_000), codec::Value::int(-9_007_199_254_740_993)
            codec::Value::float32(0.5), codec::Value::datetime(1_699_999_999_000), codec::Value::bool(false), codec::Value::text("héllo 🌍")]
        let mut buf: Vec<u8> = #[]
        for v in vals { codec::encode_into(&mut buf, v) }
        let mut names: Vec<String> = #[]
        for i in 0..vals.len() { names.push("c" + i.to_string()) }
        let out = super::render(buf, super::render_plan(names), 1)
        // Every column renders what Display renders, quoted where
        // JSON asks for a string.
        let mut want = "{\"id\":1"
        for i in 0..vals.len() {
            let v = vals[i]
            let cell = v.to_string()
            let quoted = v.tag == codec::TAG_TEXT || v.tag == codec::TAG_DT
            want = want + ",\"" + names[i] + "\":" + (if quoted { "\"" + cell + "\"" } else { cell })
        }
        want = want + "}"
        assert_eq(out, want)
    }

    #[test]
    fn a_value_renders_the_same_alone_as_it_does_in_a_row() {
        let vals = #[codec::Value::nil(), codec::Value::bool(true), codec::Value::int32(5), codec::Value::float(2.5)
            codec::Value::text("a\"b"), codec::Value::datetime(0)]
        for v in vals {
            let mut buf: Vec<u8> = #[]
            codec::encode_into(&mut buf, v)
            assert_eq(super::render(buf, super::render_plan(#["n"]), 1), "{\"id\":1,\"n\":" + super::value(v) + "}")
        }
    }
}
